module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  function.def @force_zero(%value: !felt.type<"bn128">) attributes {function.allow_constraint} {
    %zero = felt.const 0 : <"bn128">
    constrain.eq %value, %zero : !felt.type<"bn128">, !felt.type<"bn128">
    function.return
  }

  struct.def @Main {
    struct.member @out : !felt.type<"bn128"> {llzk.pub}

    function.def @compute(%input: !felt.type<"bn128">) -> !struct.type<@Main> attributes {function.allow_witness} {
      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@out] = %input : !struct.type<@Main>, !felt.type<"bn128">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(%self: !struct.type<@Main>, %input: !felt.type<"bn128">) attributes {function.allow_constraint} {
      %one = felt.const 1 : <"bn128">
      constrain.eq %input, %one : !felt.type<"bn128">, !felt.type<"bn128">
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"bn128">
      constrain.eq %out, %input : !felt.type<"bn128">, !felt.type<"bn128">
      function.call @force_zero(%out) : (!felt.type<"bn128">) -> ()
      function.return
    }
  }
}
