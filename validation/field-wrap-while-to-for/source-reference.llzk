module attributes {llzk.lang = "circom", llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type<"babybear"> {llzk.pub}

    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %one = felt.const 1 <"babybear">
      struct.writem %self[@out] = %one : !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(%self: !struct.type<@Main>) attributes {function.allow_constraint, function.allow_non_native_field_ops} {
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"babybear">
      %one = felt.const 1 <"babybear">
      %zero = felt.const 0 <"babybear">
      constrain.eq %out, %one : !felt.type<"babybear">
      constrain.eq %out, %zero : !felt.type<"babybear">
      function.return
    }
  }
}
