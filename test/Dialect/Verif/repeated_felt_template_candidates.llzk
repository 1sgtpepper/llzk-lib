// RUN: llzk-opt -split-input-file -verify-diagnostics %s

module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @RepeatedFelt {
    poly.param @F : !felt.type<"bn128">
    function.def @accept(
        %global: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %literal: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      function.return
    }
    verif.contract @Base for @RepeatedFelt::@accept (
        %global: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %literal: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  module @globals {
    global.def const @G : !felt.type<"bn128"> = 35
  }

  // Equal global and literal candidates permit both explicit and omitted arguments.
  function.def @same_value(
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 35 : !felt.type<"bn128">>
      ]>>
  ) {
    function.return
  }
  verif.contract @SameValue for @same_value (
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 35 : !felt.type<"bn128">>
      ]>>
  ) {
    verif.include @RepeatedFelt::@Base<[
        #felt<const 35 : !felt.type<"bn128">>
    ]>(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 35 : !felt.type<"bn128">>]>>) -> ()
    verif.include @RepeatedFelt::@Base(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 35 : !felt.type<"bn128">>]>>) -> ()
  }

  function.def @different_value(
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 36 : !felt.type<"bn128">>
      ]>>
  ) {
    function.return
  }
  verif.contract @DifferentValue for @different_value (
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 36 : !felt.type<"bn128">>
      ]>>
  ) {
    // expected-error@+1 {{'verif.include' op template instantiation value '#felt<const 35 : <"bn128">> : !felt.type<"bn128">' for parameter "@F" conflicts with value '#felt<const 36 : <"bn128">> : !felt.type<"bn128">' inferred from contract type signature}}
    verif.include @RepeatedFelt::@Base<[
        #felt<const 35 : !felt.type<"bn128">>
    ]>(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 36 : !felt.type<"bn128">>]>>) -> ()
  }
}

// -----

module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @RepeatedFelt {
    poly.param @F : !felt.type<"bn128">
    function.def @accept(
        %global: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %literal: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      function.return
    }
    verif.contract @Base for @RepeatedFelt::@accept (
        %global: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %literal: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  module @globals {
    global.def const @G : !felt.type<"bn128"> = 35
  }

  function.def @different_value(
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 36 : !felt.type<"bn128">>
      ]>>
  ) {
    function.return
  }
  verif.contract @DifferentValue for @different_value (
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 36 : !felt.type<"bn128">>
      ]>>
  ) {
    // expected-error@+1 {{'verif.include' op cannot infer template instantiation value for parameter "@F" from contract type signature}}
    verif.include @RepeatedFelt::@Base(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 36 : !felt.type<"bn128">>]>>) -> ()
  }
}
