// RUN: llzk-opt -split-input-file -verify-diagnostics %s

module attributes {llzk.lang} {
  poly.template @Target {
    poly.param @F : !felt.type<"bn128">
    function.def @accept() {
      function.return
    }
    verif.contract @Base for @Target::@accept() {
      %ok = arith.constant true
      verif.ensure_compute %ok
    }
  }

  module @globals {
    global.def const @G : !felt.type = 35
    global.def const @H : !felt.type<"goldilocks"> = 35
  }

  function.def @fieldlessGlobal() {
    function.return
  }
  verif.contract @FieldlessGlobal for @fieldlessGlobal() {
    // expected-error@+1 {{'verif.include' op instantiation value '@globals::@G' is not compatible with parameter "@F" type restriction '!felt.type<"bn128">'}}
    verif.include @Target::@Base<[@globals::@G]>() : () -> ()
  }

  function.def @mismatchedGlobal() {
    function.return
  }
  verif.contract @MismatchedGlobal for @mismatchedGlobal() {
    // expected-error@+1 {{'verif.include' op instantiation value '@globals::@H' is not compatible with parameter "@F" type restriction '!felt.type<"bn128">'}}
    verif.include @Target::@Base<[@globals::@H]>() : () -> ()
  }
}
