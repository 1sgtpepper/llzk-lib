// RUN: llzk-opt -split-input-file -verify-diagnostics %s

module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @RepeatedFelt {
    poly.param @F : !felt.type<"bn128">
    function.def @accept(
        %global: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %literal: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      function.return
    }
  }

  module @globals {
    global.def const @G : !felt.type<"bn128"> = 35
  }

  function.def @equivalent(
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 35 : !felt.type<"bn128">>
      ]>>
  ) {
    function.call @RepeatedFelt::@accept<[
        #felt<const 35 : !felt.type<"bn128">>
    ]>(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 35 : !felt.type<"bn128">>]>>) -> ()
    function.call @RepeatedFelt::@accept(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 35 : !felt.type<"bn128">>]>>) -> ()
    function.return
  }
}

// -----

module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @RepeatedFelt {
    poly.param @F : !felt.type<"bn128">
    function.def @accept(
        %global: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %literal: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      function.return
    }
  }

  module @globals {
    global.def const @G : !felt.type<"bn128"> = 35
  }

  function.def @different_value(
      %global: !struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
      %literal: !struct.type<@BoxTemplate::@Box<[
          #felt<const 36 : !felt.type<"bn128">>
      ]>>
  ) {
    // expected-error@+1 {{'function.call' op cannot infer template instantiation value for parameter "@F" from function type signature}}
    function.call @RepeatedFelt::@accept(%global, %literal) :
        (!struct.type<@BoxTemplate::@Box<[@globals::@G]>>,
         !struct.type<@BoxTemplate::@Box<[#felt<const 36 : !felt.type<"bn128">>]>>) -> ()
    function.return
  }
}

// -----

// Same-spelled parameters in different template scopes must still validate an omitted argument.
module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @Target {
    poly.param @F : !felt.type<"bn128">
    function.def @accept(%value: !struct.type<@BoxTemplate::@Box<[@F]>>) {
      function.return
    }
  }

  poly.template @Caller {
    poly.param @F : !felt.type<"goldilocks">
    function.def @same_name_omitted(%value: !struct.type<@BoxTemplate::@Box<[@F]>>) {
      // expected-error@+1 {{'function.call' op instantiation value '@F' is not compatible with parameter "@F" type restriction '!felt.type<"bn128">'}}
      function.call @Target::@accept(%value) :
          (!struct.type<@BoxTemplate::@Box<[@F]>>) -> ()
      function.return
    }
  }
}

// -----

// An unrestricted binding cannot hide conflicting fields in later symbolic candidates.
module attributes {llzk.lang} {
  poly.template @BoxTemplate {
    poly.param @P
    struct.def @Box {
      function.def @compute() -> !struct.type<@BoxTemplate::@Box<[@P]>> {
        %self = struct.new : <@BoxTemplate::@Box<[@P]>>
        function.return %self : !struct.type<@BoxTemplate::@Box<[@P]>>
      }
      function.def @constrain(%self: !struct.type<@BoxTemplate::@Box<[@P]>>) {
        function.return
      }
    }
  }

  poly.template @RepeatedFelt {
    poly.param @F : !felt.type
    function.def @accept(
        %unknown: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %first: !struct.type<@BoxTemplate::@Box<[@F]>>,
        %second: !struct.type<@BoxTemplate::@Box<[@F]>>
    ) {
      function.return
    }
  }

  poly.template @Caller {
    poly.param @Unknown
    poly.param @First : !felt.type<"bn128">
    poly.param @Second : !felt.type<"goldilocks">
    function.def @caller(
        %unknown: !struct.type<@BoxTemplate::@Box<[@Unknown]>>,
        %first: !struct.type<@BoxTemplate::@Box<[@First]>>,
        %second: !struct.type<@BoxTemplate::@Box<[@Second]>>
    ) {
      // expected-error@+1 {{'function.call' op cannot infer template instantiation value for parameter "@F" from function type signature}}
      function.call @RepeatedFelt::@accept(%unknown, %first, %second) :
          (!struct.type<@BoxTemplate::@Box<[@Unknown]>>,
           !struct.type<@BoxTemplate::@Box<[@First]>>,
           !struct.type<@BoxTemplate::@Box<[@Second]>>) -> ()
      function.return
    }
  }
}
