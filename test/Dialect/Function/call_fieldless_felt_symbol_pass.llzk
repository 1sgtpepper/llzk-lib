// RUN: llzk-opt -verify-diagnostics %s

// A fieldless restriction accepts known-field symbols from a global or enclosing template.
module attributes {llzk.lang} {
  global.def const @GlobalValue : !felt.type<"bn128"> = 35

  poly.template @Target {
    poly.param @N : !felt.type
    function.def @id() -> index {
      %zero = arith.constant 0 : index
      function.return %zero : index
    }
  }

  poly.template @Caller {
    poly.param @LocalValue : !felt.type<"bn128">
    function.def @use() -> index {
      %global = function.call @Target::@id<[@GlobalValue]>() : () -> index
      %local = function.call @Target::@id<[@LocalValue]>() : () -> index
      function.return %local : index
    }
  }
}
