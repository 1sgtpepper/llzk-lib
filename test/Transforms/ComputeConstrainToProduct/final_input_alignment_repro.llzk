// RUN: llzk-opt --llzk-compute-constrain-to-product="root-struct=Main" %s | FileCheck %s

// The final child inputs are different operations: compute derives 1 with
// felt.add, while constrain derives 2 with felt.mul.  The child computes a
// fixed tag of 2, so the original pair is satisfiable.  Comparing only the
// first child input aligns these calls anyway and adds a false 2 == 1
// constraint to the product.
module attributes {llzk.lang} {
  struct.def @Child {
    struct.member @tag : !felt.type

    function.def @compute(
        %input: !felt.type, %tag: !felt.type
    ) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      %fixed_tag = felt.const 2
      struct.writem %self[@tag] = %fixed_tag :
          !struct.type<@Child>, !felt.type
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(
        %self: !struct.type<@Child>, %input: !felt.type, %tag: !felt.type
    ) {
      %stored_tag = struct.readm %self[@tag] : !struct.type<@Child>, !felt.type
      constrain.eq %stored_tag, %tag : !felt.type
      function.return
    }
  }

  struct.def @Main {
    struct.member @child : !struct.type<@Child>

    function.def @compute() -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %zero = felt.const 0
      %compute_tag_base = felt.const 1
      %compute_tag = felt.add %compute_tag_base, %zero :
          !felt.type, !felt.type
      %child = function.call @Child::@compute(%zero, %compute_tag) :
          (!felt.type, !felt.type) -> !struct.type<@Child>
      struct.writem %self[@child] = %child :
          !struct.type<@Main>, !struct.type<@Child>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(%self: !struct.type<@Main>) {
      %zero = felt.const 0
      %constrain_tag_base = felt.const 2
      %one = felt.const 1
      %constrain_tag = felt.mul %constrain_tag_base, %one :
          !felt.type, !felt.type
      %child = struct.readm %self[@child] :
          !struct.type<@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %zero, %constrain_tag) :
          (!struct.type<@Child>, !felt.type, !felt.type) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Child {
// CHECK-NEXT:      struct.member @tag : !felt.type
// CHECK-NEXT:      function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Child> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_2]][@tag] = %[[VAL_3]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_2]][@tag] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_4]], %[[VAL_1]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @compute(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Child> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = struct.new : <@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_7]][@tag] = %[[VAL_8]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        function.return {product_source = "compute"} %[[VAL_7]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_9:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>, %[[VAL_10:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_11:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_9]][@tag] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_12]], %[[VAL_11]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        function.return {product_source = "constrain"}
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      struct.member @child : !struct.type<@Child>
// CHECK-NEXT:      function.def @product() -> !struct.type<@Main> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = felt.const  1 {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_15]], %[[VAL_14]] : !felt.type, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = function.call @Child::@product(%[[VAL_14]], %[[VAL_16]]) : (!felt.type, !felt.type) -> !struct.type<@Child>
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_14]], %[[VAL_16]]) : (!felt.type, !felt.type) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_13]][@child] = %[[VAL_17]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_19:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_20:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_21:[0-9a-zA-Z_\.]+]] = felt.const  1 {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_22:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_20]], %[[VAL_21]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_23:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_13]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT:        function.call @Child::@constrain(%[[VAL_23]], %[[VAL_19]], %[[VAL_22]]) : (!struct.type<@Child>, !felt.type, !felt.type) -> ()  {product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_13]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @compute() -> !struct.type<@Main> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:        %[[VAL_24:[0-9a-zA-Z_\.]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_25:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_26:[0-9a-zA-Z_\.]+]] = felt.const  1 {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_27:[0-9a-zA-Z_\.]+]] = felt.add %[[VAL_26]], %[[VAL_25]] : !felt.type, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_28:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_25]], %[[VAL_27]]) : (!felt.type, !felt.type) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_24]][@child] = %[[VAL_28]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT:        function.return {product_source = "compute"} %[[VAL_24]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_29:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:        %[[VAL_30:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_31:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_32:[0-9a-zA-Z_\.]+]] = felt.const  1 {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_33:[0-9a-zA-Z_\.]+]] = felt.mul %[[VAL_31]], %[[VAL_32]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_34:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_29]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT:        function.call @Child::@constrain(%[[VAL_34]], %[[VAL_30]], %[[VAL_33]]) : (!struct.type<@Child>, !felt.type, !felt.type) -> ()  {product_source = "constrain"}
// CHECK-NEXT:        function.return {product_source = "constrain"}
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
