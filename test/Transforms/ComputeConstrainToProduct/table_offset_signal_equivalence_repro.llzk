// RUN: llzk-opt --llzk-compute-constrain-to-product="root-struct=Main" %s | FileCheck %s

// The two child inputs are reads from different table rows.  The current
// signal-equivalence helper replaces both reads with the latest member write,
// discarding the member-read tableOffset identity and aligning calls that are
// not semantically equivalent.
module attributes {llzk.lang} {
  struct.def @Child {
    struct.member @out : !felt.type

    function.def @compute(%input: !felt.type) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      struct.writem %self[@out] = %input : !struct.type<@Child>, !felt.type
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(
        %self: !struct.type<@Child>, %input: !felt.type
    ) {
      %out = struct.readm %self[@out] : !struct.type<@Child>, !felt.type
      constrain.eq %out, %input : !felt.type
      function.return
    }
  }

  struct.def @Main {
    struct.member @cell : !felt.type {column}
    struct.member @child : !struct.type<@Child>

    function.def @compute(
        %offset: index, %value: !felt.type
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@cell] = %value : !struct.type<@Main>, !felt.type
      %previous = struct.readm %self[@cell] {()[%offset]}
          : !struct.type<@Main>, !felt.type {tableOffset = -1 : index}
      %child = function.call @Child::@compute(%previous) :
          (!felt.type) -> !struct.type<@Child>
      struct.writem %self[@child] = %child :
          !struct.type<@Main>, !struct.type<@Child>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
        %self: !struct.type<@Main>, %offset: index, %value: !felt.type
    ) {
      %current = struct.readm %self[@cell] : !struct.type<@Main>, !felt.type
      %child = struct.readm %self[@child] :
          !struct.type<@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %current) :
          (!struct.type<@Child>, !felt.type) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: struct.def @Main {
// CHECK:       function.def @product
// CHECK:       %[[PREVIOUS:[0-9a-zA-Z_\.]+]] = struct.readm %{{.*}}[@cell]
// CHECK-SAME:  {()[%{{.*}}]} : <@Main>, !felt.type {tableOffset = -1 : index}
// CHECK:       function.call @Child::@product(%[[PREVIOUS]])
