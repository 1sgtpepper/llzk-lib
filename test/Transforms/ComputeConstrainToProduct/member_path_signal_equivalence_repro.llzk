// RUN: llzk-opt --llzk-compute-constrain-to-product="root-struct=Main" %s | FileCheck %s

// The compute-side read of @a carries %a, while the constraint-side child
// input is the independent %b argument.  For a=1 and b=2, the original pair
// is satisfiable because the child computes a fixed output of 2.  The current
// helper scans backwards for any MemberWriteOp, replaces the @a read with the
// later @b write, and adds a product constraint requiring that fixed 2 to
// equal a.
module attributes {llzk.lang} {
  struct.def @Child {
    struct.member @out : !felt.type

    function.def @compute(%input: !felt.type) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      %fixed_out = felt.const 2
      struct.writem %self[@out] = %fixed_out :
          !struct.type<@Child>, !felt.type
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(%self: !struct.type<@Child>, %input: !felt.type) {
      %out = struct.readm %self[@out] : !struct.type<@Child>, !felt.type
      constrain.eq %out, %input : !felt.type
      function.return
    }
  }

  struct.def @Main {
    struct.member @a : !felt.type
    struct.member @b : !felt.type
    struct.member @child : !struct.type<@Child>

    function.def @compute(
        %a: !felt.type, %b: !felt.type
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@a] = %a : !struct.type<@Main>, !felt.type
      struct.writem %self[@b] = %b : !struct.type<@Main>, !felt.type
      %from_a = struct.readm %self[@a] : !struct.type<@Main>, !felt.type
      %child = function.call @Child::@compute(%from_a) :
          (!felt.type) -> !struct.type<@Child>
      struct.writem %self[@child] = %child :
          !struct.type<@Main>, !struct.type<@Child>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
        %self: !struct.type<@Main>, %a: !felt.type, %b: !felt.type
    ) {
      %child = struct.readm %self[@child] :
          !struct.type<@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %b) :
          (!struct.type<@Child>, !felt.type) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Child {
// CHECK-NEXT:      struct.member @out : !felt.type
// CHECK-NEXT:      function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Child> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:        %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_1]][@out] = %[[VAL_2]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_1]][@out] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_3]], %[[VAL_0]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_1]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @compute(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Child> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = struct.new : <@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_5]][@out] = %[[VAL_6]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        function.return {product_source = "compute"} %[[VAL_5]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_7:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>, %[[VAL_8:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_7]][@out] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_9]], %[[VAL_8]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        function.return {product_source = "constrain"}
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      struct.member @a : !felt.type
// CHECK-NEXT:      struct.member @b : !felt.type
// CHECK-NEXT:      struct.member @child : !struct.type<@Child>
// CHECK-NEXT:      function.def @product(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_11:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:        %[[VAL_12:[0-9a-zA-Z_\.]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_12]][@a] = %[[VAL_10]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_12]][@b] = %[[VAL_11]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_12]][@a] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = function.call @Child::@product(%[[VAL_13]]) : (!felt.type) -> !struct.type<@Child>
// CHECK-NEXT:        %[[VAL_15:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_13]]) : (!felt.type) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_12]][@child] = %[[VAL_14]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_16:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_12]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT:        function.call @Child::@constrain(%[[VAL_16]], %[[VAL_11]]) : (!struct.type<@Child>, !felt.type) -> ()  {product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_12]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @compute(%[[VAL_17:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_18:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:        %[[VAL_19:[0-9a-zA-Z_\.]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_19]][@a] = %[[VAL_17]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_19]][@b] = %[[VAL_18]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_20:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_19]][@a] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_21:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_20]]) : (!felt.type) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_19]][@child] = %[[VAL_21]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT:        function.return {product_source = "compute"} %[[VAL_19]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_22:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_23:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_24:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:        %[[VAL_25:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_22]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT:        function.call @Child::@constrain(%[[VAL_25]], %[[VAL_24]]) : (!struct.type<@Child>, !felt.type) -> ()  {product_source = "constrain"}
// CHECK-NEXT:        function.return {product_source = "constrain"}
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
