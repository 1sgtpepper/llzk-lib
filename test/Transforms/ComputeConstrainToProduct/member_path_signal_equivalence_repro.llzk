// RUN: llzk-opt --llzk-compute-constrain-to-product="root-struct=Main" %s | FileCheck %s

// The compute-side read of @a carries %a, while the constraint-side child
// input is the independent %b argument.  The child computes a fixed output
// of 2, so the original pair is satisfiable when b = 2.  The current helper
// scans backwards for any MemberWriteOp, replaces the @a read with the later
// @b write, and adds a product constraint requiring that fixed 2 to equal a.
module attributes {llzk.lang} {
  struct.def @Child {
    struct.member @out : !felt.type
    struct.member @tag : !felt.type

    function.def @compute(
        %input: !felt.type, %tag: !felt.type
    ) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      %fixed_out = felt.const 2
      struct.writem %self[@out] = %fixed_out :
          !struct.type<@Child>, !felt.type
      struct.writem %self[@tag] = %tag : !struct.type<@Child>, !felt.type
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(
        %self: !struct.type<@Child>, %input: !felt.type, %tag: !felt.type
    ) {
      %out = struct.readm %self[@out] : !struct.type<@Child>, !felt.type
      %stored_tag = struct.readm %self[@tag] : !struct.type<@Child>, !felt.type
      constrain.eq %out, %input : !felt.type
      constrain.eq %stored_tag, %tag : !felt.type
      function.return
    }
  }

  struct.def @Main {
    struct.member @a : !felt.type
    struct.member @b : !felt.type
    struct.member @child : !struct.type<@Child>

    function.def @compute(
        %a: !felt.type, %b: !felt.type
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@a] = %a : !struct.type<@Main>, !felt.type
      struct.writem %self[@b] = %b : !struct.type<@Main>, !felt.type
      %from_a = struct.readm %self[@a] : !struct.type<@Main>, !felt.type
      %child = function.call @Child::@compute(%from_a, %a) :
          (!felt.type, !felt.type) -> !struct.type<@Child>
      struct.writem %self[@child] = %child :
          !struct.type<@Main>, !struct.type<@Child>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
        %self: !struct.type<@Main>, %a: !felt.type, %b: !felt.type
    ) {
      %child = struct.readm %self[@child] :
          !struct.type<@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %b, %a) :
          (!struct.type<@Child>, !felt.type, !felt.type) -> ()
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Child {
// CHECK-NEXT:      struct.member @out : !felt.type
// CHECK-NEXT:      struct.member @tag : !felt.type
// CHECK-NEXT:      function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Child> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_2]][@out] = %[[VAL_3]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_2]][@tag] = %[[VAL_1]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_2]][@out] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_2]][@tag] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_4]], %[[VAL_0]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_5]], %[[VAL_1]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @compute(%[[VAL_6:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_7:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Child> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = struct.new : <@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = felt.const  2 {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_8]][@out] = %[[VAL_9]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_8]][@tag] = %[[VAL_7]] : <@Child>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        function.return {product_source = "compute"} %[[VAL_8]] : !struct.type<@Child>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_10:[0-9a-zA-Z_\.]+]]: !struct.type<@Child>, %[[VAL_11:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_12:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:        %[[VAL_13:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_10]][@out] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        %[[VAL_14:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_10]][@tag] : <@Child>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_13]], %[[VAL_11]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        constrain.eq %[[VAL_14]], %[[VAL_12]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:        function.return {product_source = "constrain"}
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    struct.def @Main {
// CHECK-NEXT:      struct.member @a : !felt.type
// CHECK-NEXT:      struct.member @b : !felt.type
// CHECK-NEXT:      struct.member @child : !struct.type<@Child>
// CHECK-NEXT:      function.def @product(%[[VAL_15:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_16:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_17]][@a] = %[[VAL_15]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_17]][@b] = %[[VAL_16]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_17]][@a] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_19:[0-9a-zA-Z_\.]+]] = function.call @Child::@product(%[[VAL_18]], %[[VAL_15]]) : (!felt.type, !felt.type) -> !struct.type<@Child>
// CHECK-NEXT:        %[[VAL_20:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_18]], %[[VAL_15]]) : (!felt.type, !felt.type) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_17]][@child] = %[[VAL_19]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_21:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_17]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT:        function.call @Child::@constrain(%[[VAL_21]], %[[VAL_16]], %[[VAL_15]]) : (!struct.type<@Child>, !felt.type, !felt.type) -> ()  {product_source = "constrain"}
// CHECK-NEXT:        function.return %[[VAL_17]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @compute(%[[VAL_22:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_23:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Main> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:        %[[VAL_24:[0-9a-zA-Z_\.]+]] = struct.new : <@Main> {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_24]][@a] = %[[VAL_22]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_24]][@b] = %[[VAL_23]] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_25:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_24]][@a] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_26:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_25]], %[[VAL_22]]) : (!felt.type, !felt.type) -> !struct.type<@Child>  {product_source = "compute"}
// CHECK-NEXT:        struct.writem %[[VAL_24]][@child] = %[[VAL_26]] : <@Main>, !struct.type<@Child> {product_source = "compute"}
// CHECK-NEXT:        function.return {product_source = "compute"} %[[VAL_24]] : !struct.type<@Main>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_27:[0-9a-zA-Z_\.]+]]: !struct.type<@Main>, %[[VAL_28:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_29:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:        %[[VAL_30:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_27]][@child] : <@Main>, !struct.type<@Child> {product_source = "constrain"}
// CHECK-NEXT:        function.call @Child::@constrain(%[[VAL_30]], %[[VAL_29]], %[[VAL_28]]) : (!struct.type<@Child>, !felt.type, !felt.type) -> ()  {product_source = "constrain"}
// CHECK-NEXT:        function.return {product_source = "constrain"}
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
