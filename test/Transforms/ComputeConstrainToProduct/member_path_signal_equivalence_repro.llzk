// CHECK-NEXT:        %[[VAL_17:[0-9a-zA-Z_\.]+]] = function.call @Child::@product(%[[VAL_16]], %[[VAL_13]]) : (!felt.type, !felt.type) -> !struct.type<@Child>
// CHECK-NEXT:        %[[VAL_18:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_16]], %[[VAL_13]]) : (!felt.type, !felt.type) -> !struct.type<@Child>  {product_source = "compute"}
