// CHECK-NEXT:        %[[VAL_23:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_22]][@a] : <@Main>, !felt.type {product_source = "compute"}
// CHECK-NEXT:        %[[VAL_24:[0-9a-zA-Z_\.]+]] = function.call @Child::@compute(%[[VAL_23]], %[[VAL_20]]) : (!felt.type, !felt.type) -> !struct.type<@Child>  {product_source = "compute"}
