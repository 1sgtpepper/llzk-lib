// RUN: llzk-opt -split-input-file --llzk-compute-constrain-to-product="root-struct=A" --llzk-fuse-product-control-flow %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @compute(%b: i1, %a: !felt.type) -> !struct.type<@A> {
      %self = struct.new : <@A>

      %0 = scf.if %b -> !felt.type {
        %val = felt.const 0
        scf.yield %val : !felt.type
      } else {
        %val = felt.const 1
        scf.yield %val : !felt.type
      }
      struct.writem %self[@foo] = %0 : <@A>, !felt.type

      function.return %self : !struct.type<@A>
    }

    function.def @constrain(%self: !struct.type<@A>, %b: i1, %a: !felt.type) {
      scf.if %b {
        %val = felt.const 0
        constrain.eq %a, %val : !felt.type
      } else {
        %val = felt.const 1
        constrain.eq %a, %val : !felt.type
      }

      function.return
    }
  }
}

