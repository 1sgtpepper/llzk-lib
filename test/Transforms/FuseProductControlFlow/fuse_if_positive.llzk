// -----

// Loop fusion makes the nested conditional pair siblings, so the fused loop must be revisited.

module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%condition: i1, %value: !felt.type) -> !struct.type<@A> {
      %self = struct.new : <@A>
      %c0_compute = arith.constant 0 : index
      %c2_compute = arith.constant 2 : index
      %c1_compute = arith.constant 1 : index

      scf.for %i = %c0_compute to %c2_compute step %c1_compute {
        scf.if %condition {
          %zero = felt.const 0
        } else {
          %one = felt.const 1
        } {product_source = "compute"}
      } {product_source = "compute"}

      %c0_constrain = arith.constant 0 : index
      %c2_constrain = arith.constant 2 : index
      %c1_constrain = arith.constant 1 : index

      scf.for %i = %c0_constrain to %c2_constrain step %c1_constrain {
        scf.if %condition {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        } {product_source = "constrain"}
      } {product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}

