// -----

// Outer if fusion makes the branch-local pairs siblings; both new branches must be revisited.

module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%outer: i1, %inner: i1, %value: !felt.type) -> !struct.type<@A> {
      %self = struct.new : <@A>

      scf.if %outer {
        scf.if %inner {
          %then_true = felt.const 10
        } else {
          %then_false = felt.const 11
        } {product_source = "compute"}
      } else {
        scf.if %inner {
          %else_true = felt.const 20
        } else {
          %else_false = felt.const 21
        } {product_source = "compute"}
      } {product_source = "compute"}

      scf.if %outer {
        scf.if %inner {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        } {product_source = "constrain"}
      } else {
        scf.if %inner {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        } {product_source = "constrain"}
      } {product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}

