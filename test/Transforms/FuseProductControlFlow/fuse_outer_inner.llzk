// RUN: llzk-opt --llzk-compute-constrain-to-product="root-struct=A" --llzk-fuse-product-loops %s | FileCheck --enable-var-scope %s
// REQUIRES: raghav-cf-fusion

module attributes {llzk.lang = "llzk"} {
    poly.template @TA {
      poly.param @N : index

      struct.def @A {
          struct.member @arr : !array.type<@N, @N x !felt.type>

          function.def @compute(%inp: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> {
              %self = struct.new : <@TA::@A<[@N]>>

              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index
              %N = poly.read_const @N : index

              %arr = array.new : !array.type<@N, @N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  scf.for %j = %c0 to %N step %c1 {
                      %k = arith.addi %i, %j : index
                      %elem = array.read %inp[%k] : !array.type<@N x !felt.type>, !felt.type
                      array.write %arr[%i, %j] = %elem : !array.type<@N, @N x !felt.type>, !felt.type
                  }
              }

              struct.writem %self[@arr] = %arr : !struct.type<@TA::@A<[@N]>>, !array.type<@N, @N x !felt.type>
              function.return %self : !struct.type<@TA::@A<[@N]>>
          }

          function.def @constrain(%self: !struct.type<@TA::@A<[@N]>>, %inp: !array.type<@N x !felt.type>) {
              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index
              %N = poly.read_const @N : index

              %arr = struct.readm %self[@arr] : !struct.type<@TA::@A<[@N]>>, !array.type<@N, @N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  scf.for %j = %c0 to %N step %c1 {
                      %k = arith.addi %i, %j : index
                      %elem1 = array.read %inp[%k] : !array.type<@N x !felt.type>, !felt.type
                      %elem2 = array.read %arr[%i, %j] : !array.type<@N, @N x !felt.type>, !felt.type
                      constrain.eq %elem1, %elem2 : !felt.type
                  }
              }

              function.return
          }

      }
    }
}

// CHECK-LABEL: module attributes {llzk.lang = "llzk"} {
// CHECK-NEXT:    poly.template @TA {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      struct.def @A {
// CHECK-NEXT:        struct.member @arr : !array.type<@N,@N x !felt.type>
// CHECK-NEXT:        function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@TA::@A<[@N]>> {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 0 : index
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 1 : index
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.new  : <@N,@N x !felt.type>  {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 0 : index
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 1 : index
// CHECK-NEXT:          %[[VAL_8:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "constrain"}
// CHECK-NEXT:          %[[VAL_9:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_1]][@arr] : <@TA::@A<[@N]>>, !array.type<@N,@N x !felt.type> {product_source = "constrain"}
// CHECK-NEXT:          scf.for %[[VAL_10:[0-9a-zA-Z_\.]+]] = %[[VAL_6]] to %[[VAL_8]] step %[[VAL_7]] {
// CHECK-NEXT:            scf.for %[[VAL_11:[0-9a-zA-Z_\.]+]] = %[[VAL_6]] to %[[VAL_8]] step %[[VAL_7]] {
// CHECK-NEXT:              %[[VAL_12:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_10]], %[[VAL_11]] {product_source = "compute"} : index
// CHECK-NEXT:              %[[VAL_13:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_0]]{{\[}}%[[VAL_12]]] : <@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:              array.write %[[VAL_5]]{{\[}}%[[VAL_10]], %[[VAL_11]]] = %[[VAL_13]] : <@N,@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:              %[[VAL_14:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_10]], %[[VAL_11]] {product_source = "constrain"} : index
// CHECK-NEXT:              %[[VAL_15:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_0]]{{\[}}%[[VAL_14]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:              %[[VAL_16:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_9]]{{\[}}%[[VAL_10]], %[[VAL_11]]] : <@N,@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:              constrain.eq %[[VAL_15]], %[[VAL_16]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            } {product_source = "fused"}
// CHECK-NEXT:          } {product_source = "fused"}
// CHECK-NEXT:          struct.writem %[[VAL_1]][@arr] = %[[VAL_5]] : <@TA::@A<[@N]>>, !array.type<@N,@N x !felt.type> {product_source = "compute"}
// CHECK-NEXT:          function.return %[[VAL_1]] : !struct.type<@TA::@A<[@N]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @compute(%[[VAL_17:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> attributes {function.allow_witness, product_source = "compute"} {
// CHECK-NEXT:          %[[VAL_18:[0-9a-zA-Z_\.]+]] = struct.new : <@TA::@A<[@N]>> {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_19:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 0 : index
// CHECK-NEXT:          %[[VAL_20:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 1 : index
// CHECK-NEXT:          %[[VAL_21:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_22:[0-9a-zA-Z_\.]+]] = array.new  : <@N,@N x !felt.type>  {product_source = "compute"}
// CHECK-NEXT:          scf.for %[[VAL_23:[0-9a-zA-Z_\.]+]] = %[[VAL_19]] to %[[VAL_21]] step %[[VAL_20]] {
// CHECK-NEXT:            scf.for %[[VAL_24:[0-9a-zA-Z_\.]+]] = %[[VAL_19]] to %[[VAL_21]] step %[[VAL_20]] {
// CHECK-NEXT:              %[[VAL_25:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_23]], %[[VAL_24]] {product_source = "compute"} : index
// CHECK-NEXT:              %[[VAL_26:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_17]]{{\[}}%[[VAL_25]]] : <@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:              array.write %[[VAL_22]]{{\[}}%[[VAL_23]], %[[VAL_24]]] = %[[VAL_26]] : <@N,@N x !felt.type>, !felt.type {product_source = "compute"}
// CHECK-NEXT:            } {product_source = "compute"}
// CHECK-NEXT:          } {product_source = "compute"}
// CHECK-NEXT:          struct.writem %[[VAL_18]][@arr] = %[[VAL_22]] : <@TA::@A<[@N]>>, !array.type<@N,@N x !felt.type> {product_source = "compute"}
// CHECK-NEXT:          function.return {product_source = "compute"} %[[VAL_18]] : !struct.type<@TA::@A<[@N]>>
// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_27:[0-9a-zA-Z_\.]+]]: !struct.type<@TA::@A<[@N]>>, %[[VAL_28:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:          %[[VAL_29:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 0 : index
// CHECK-NEXT:          %[[VAL_30:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 1 : index
// CHECK-NEXT:          %[[VAL_31:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "constrain"}
// CHECK-NEXT:          %[[VAL_32:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_27]][@arr] : <@TA::@A<[@N]>>, !array.type<@N,@N x !felt.type> {product_source = "constrain"}
// CHECK-NEXT:          scf.for %[[VAL_33:[0-9a-zA-Z_\.]+]] = %[[VAL_29]] to %[[VAL_31]] step %[[VAL_30]] {
// CHECK-NEXT:            scf.for %[[VAL_34:[0-9a-zA-Z_\.]+]] = %[[VAL_29]] to %[[VAL_31]] step %[[VAL_30]] {
// CHECK-NEXT:              %[[VAL_35:[0-9a-zA-Z_\.]+]] = arith.addi %[[VAL_33]], %[[VAL_34]] {product_source = "constrain"} : index
// CHECK-NEXT:              %[[VAL_36:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_28]]{{\[}}%[[VAL_35]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:              %[[VAL_37:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_32]]{{\[}}%[[VAL_33]], %[[VAL_34]]] : <@N,@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:              constrain.eq %[[VAL_36]], %[[VAL_37]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            } {product_source = "constrain"}
// CHECK-NEXT:          } {product_source = "constrain"}
// CHECK-NEXT:          function.return {product_source = "constrain"}
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
