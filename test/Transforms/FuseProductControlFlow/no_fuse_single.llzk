// -----
module attributes {llzk.lang = "llzk"} {
    poly.template @TA {
      poly.param @N : index
      poly.param @M : index

      struct.def @A {
          struct.member @arr : !array.type<@N x !felt.type>
          function.def @compute(%inp: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N, @M]>> {
              %self = struct.new : <@TA::@A<[@N, @M]>>

              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index
              %N = poly.read_const @N : index
              %M = poly.read_const @M : index
              %felt0 = felt.const 0

              %arr = array.new : !array.type<@N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  %below_M = arith.cmpi ult, %i, %M : index
                  scf.if %below_M {
                      array.write %arr[%i] = %felt0 : !array.type<@N x !felt.type>, !felt.type
                  } else {
                      %elem = array.read %inp[%i] : !array.type<@N x !felt.type>, !felt.type
                      array.write %arr[%i] = %elem : !array.type<@N x !felt.type>, !felt.type
                  }
              }

              struct.writem %self[@arr] = %arr : !struct.type<@TA::@A<[@N, @M]>>, !array.type<@N x !felt.type>
              function.return %self : !struct.type<@TA::@A<[@N, @M]>>
          }

          function.def @constrain(%self: !struct.type<@TA::@A<[@N, @M]>>, %inp: !array.type<@N x !felt.type>) {
              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index
              %N = poly.read_const @N : index
              %M = poly.read_const @M : index
              %felt0 = felt.const 0

              %arr = struct.readm %self[@arr] : !struct.type<@TA::@A<[@N, @M]>>, !array.type<@N x !felt.type>

              %N_lt_M = arith.cmpi ult, %N, %M : index
              scf.if %N_lt_M {
                  scf.for %i = %c0 to %N step %c1 {
                      %arr_i = array.read %arr[%i] : !array.type<@N x !felt.type>, !felt.type
                      constrain.eq %arr_i, %felt0 : !felt.type
                  }
              } else {
                  scf.for %i = %c0 to %M step %c1 {
                      %elem = array.read %inp[%i] : !array.type<@N x !felt.type>, !felt.type
                      %arr_i = array.read %arr[%i] : !array.type<@N x !felt.type>, !felt.type
                      constrain.eq %elem, %arr_i : !felt.type
                  }
                  scf.for %i = %M to %N step %c1 {
                      %arr_i = array.read %arr[%i] : !array.type<@N x !felt.type>, !felt.type
                      constrain.eq %arr_i, %felt0 : !felt.type
                  }
              }

              function.return
          }
      }
    }
}

// CHECK-LABEL: module attributes {llzk.lang = "llzk"} {
// CHECK-NEXT:    poly.template @TA {
// CHECK-NEXT:      poly.param @N : index
// CHECK-NEXT:      poly.param @M : index
// CHECK-NEXT:      struct.def @A {
// CHECK-NEXT:        struct.member @arr : !array.type<@N x !felt.type>
// CHECK-NEXT:        function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N, @M]>> attributes {function.allow_constraint, function.allow_witness, llzk.derived} {
// CHECK-NEXT:          %[[VAL_1:[0-9a-zA-Z_\.]+]] = struct.new : <@TA::@A<[@N, @M]>> {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_2:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 0 : index
// CHECK-NEXT:          %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "compute"} 1 : index
// CHECK-NEXT:          %[[VAL_4:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_5:[0-9a-zA-Z_\.]+]] = poly.read_const @M : index {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_6:[0-9a-zA-Z_\.]+]] = felt.const  0 {product_source = "compute"}
// CHECK-NEXT:          %[[VAL_7:[0-9a-zA-Z_\.]+]] = array.new  : <@N x !felt.type>  {product_source = "compute"}
// CHECK-NEXT:          scf.for %[[VAL_8:[0-9a-zA-Z_\.]+]] = %[[VAL_2]] to %[[VAL_4]] step %[[VAL_3]] {
// CHECK-NEXT:            %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.cmpi ult, %[[VAL_8]], %[[VAL_5]] {product_source = "compute"} : index
// CHECK-NEXT:            scf.if %[[VAL_9]] {
