// CHECK-NEXT:        }
// CHECK-NEXT:        function.def @constrain(%[[VAL_19:[0-9a-zA-Z_\.]+]]: !struct.type<@TA::@A<[@N]>>, %[[VAL_20:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint, product_source = "constrain"} {
// CHECK-NEXT:          %[[VAL_21:[0-9a-zA-Z_\.]+]] = poly.read_const @N : index {product_source = "constrain"}
// CHECK-NEXT:          %[[VAL_22:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 0 : index
// CHECK-NEXT:          %[[VAL_23:[0-9a-zA-Z_\.]+]] = arith.constant {product_source = "constrain"} 1 : index
// CHECK-NEXT:          %[[VAL_24:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_19]][@arr] : <@TA::@A<[@N]>>, !array.type<@N x !felt.type> {product_source = "constrain"}
// CHECK-NEXT:          scf.for %[[VAL_25:[0-9a-zA-Z_\.]+]] = %[[VAL_22]] to %[[VAL_21]] step %[[VAL_23]] {
// CHECK-NEXT:            %[[VAL_26:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_24]]{{\[}}%[[VAL_25]]] : <@N x !felt.type>, !felt.type {product_source = "constrain"}
// CHECK-NEXT:            constrain.eq %[[VAL_20]], %[[VAL_26]] : !felt.type, !felt.type {product_source = "constrain"}
// CHECK-NEXT:          } {product_source = "constrain"}
// CHECK-NEXT:          function.return {product_source = "constrain"}
// CHECK-NEXT:        }
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----
module attributes {llzk.lang = "llzk"} {
    poly.template @TA {
      poly.param @N : index

      struct.def @A {
          struct.member @arr : !array.type<@N x !felt.type>

          function.def @compute(%as: !array.type<@N x !felt.type>) -> !struct.type<@TA::@A<[@N]>> {
              %self = struct.new : <@TA::@A<[@N]>>

              %N = poly.read_const @N : index
              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index

              %arr = array.new : !array.type<@N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  %sum0 = felt.const 0
                  %sum = scf.for %j = %i to %N step %c1 iter_args(%iter_sum = %sum0) -> !felt.type {
                      %a_j = array.read %as[%j] : !array.type<@N x !felt.type>, !felt.type
                      %0 = felt.add %iter_sum, %a_j
                      scf.yield %0 : !felt.type
                  }
                  array.write %arr[%i] = %sum : !array.type<@N x !felt.type>, !felt.type
                  scf.yield
              }

              struct.writem %self[@arr] = %arr : !struct.type<@TA::@A<[@N]>>, !array.type<@N x !felt.type>
              function.return %self : !struct.type<@TA::@A<[@N]>>
          }
          function.def @constrain(%self : !struct.type<@TA::@A<[@N]>>, %as: !array.type<@N x !felt.type>) {
              %N = poly.read_const @N : index
              %c0 = arith.constant 0 : index
              %c1 = arith.constant 1 : index

              %arr = struct.readm %self[@arr] : !struct.type<@TA::@A<[@N]>>, !array.type<@N x !felt.type>

              scf.for %i = %c0 to %N step %c1 {
                  %j = arith.addi %i, %c1 : index

                  %arr_i = array.read %arr[%i] : !array.type<@N x !felt.type>, !felt.type
                  %arr_j = array.read %arr[%j] : !array.type<@N x !felt.type>, !felt.type
                  %a = array.read %as[%i] : !array.type<@N x !felt.type>, !felt.type
                  %diff = felt.sub %arr_j, %arr_i
                  constrain.eq %a, %diff : !felt.type
                  scf.yield
              }

              function.return
          }
      }
    }
}

