// -----

// A table-offset member read refers to another row, so it cannot be hoisted across the
// compute-side write; the compute-if, write, offset read, and constrain-if stay ordered.
module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type {column, signal}

    function.def @compute(%b: i1) -> !struct.type<@A> {
      %self = struct.new : <@A>

      %0 = scf.if %b -> !felt.type {
        %a = felt.const 0
        scf.yield %a : !felt.type
      } else {
        %a = felt.const 1
        scf.yield %a : !felt.type
      }

      struct.writem %self[@foo] = %0 : <@A>, !felt.type
      function.return %self : !struct.type<@A>
    }

    function.def @constrain(%self: !struct.type<@A>, %b: i1) {
      %foo = struct.readm %self[@foo] : <@A>, !felt.type {tableOffset = -1 : index}
      scf.if %b {
        %val = felt.const 0
        constrain.eq %foo, %val : !felt.type
      } else {
        %val = felt.const 1
        constrain.eq %foo, %val : !felt.type
      }

      function.return
    }
  }
}

