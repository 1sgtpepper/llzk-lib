// Moving the compute-side conditional past a matching loop pair must still allow the parent-level
// conditional pair to fuse during the same pass.
module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @compute(%condition: i1, %value: !felt.type) -> !struct.type<@A> {
      %self = struct.new : <@A>
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %c1 = arith.constant 1 : index

      scf.for %i = %c0 to %c2 step %c1 {
        %zero = felt.const 0
      }

      scf.if %condition {
        %zero = felt.const 0
      } else {
        %one = felt.const 1
      }

      function.return %self : !struct.type<@A>
    }

    function.def @constrain(%self: !struct.type<@A>, %condition: i1, %value: !felt.type) {
      %c0 = arith.constant 0 : index
      %c2 = arith.constant 2 : index
      %c1 = arith.constant 1 : index

      scf.for %i = %c0 to %c2 step %c1 {
        constrain.eq %value, %value : !felt.type
      }

      scf.if %condition {
        constrain.eq %value, %value : !felt.type
      } else {
        constrain.eq %value, %value : !felt.type
      }

      function.return
    }
  }
}

