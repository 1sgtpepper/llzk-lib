module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%condition: i1) -> !struct.type<@A> {
      %self = struct.new : <@A>

      %computed = scf.if %condition -> !felt.type {
        %zero = felt.const 0
        scf.yield {llzk.fusion_marker = "matching"} %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield {llzk.fusion_marker = "compute-else"} %one : !felt.type
      } {llzk.fusion_marker = "if", product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@A>, !felt.type

      scf.if %condition {
        %expected = felt.const 0
        constrain.eq %computed, %expected : !felt.type
        scf.yield {llzk.fusion_marker = "matching"}
      } else {
        %expected = felt.const 1
        constrain.eq %computed, %expected : !felt.type
        scf.yield {llzk.fusion_marker = "constrain-else"}
      } {llzk.fusion_marker = "if", product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}

