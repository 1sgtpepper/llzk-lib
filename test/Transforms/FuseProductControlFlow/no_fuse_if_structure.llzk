module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%b: i1, %other: !felt.type) -> !struct.type<@A> {
      %self = struct.new : <@A>

      %computed = scf.if %b -> !felt.type {
        %zero = felt.const 0
        scf.yield %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield %one : !felt.type
      } {product_source = "compute"}

      // The only crossing write is not sourced from the compute-if result.
      struct.writem %self[@foo] = %other : <@A>, !felt.type

      scf.if %b {
        %expected = felt.const 0
        constrain.eq %computed, %expected : !felt.type
      } else {
        %expected = felt.const 1
        constrain.eq %computed, %expected : !felt.type
      } {product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}

