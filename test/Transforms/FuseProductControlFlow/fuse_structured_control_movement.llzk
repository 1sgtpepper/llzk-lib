// RUN: llzk-opt -split-input-file --llzk-fuse-product-control-flow %s | FileCheck --enable-var-scope %s

module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    // A nested scf.if is safe when its contents are individually movable.
    function.def @product(%condition: i1, %value: !felt.type) -> !struct.type<@A> attributes {function.allow_constraint, function.allow_witness} {
      %self = struct.new : <@A>

      %computed = scf.if %condition -> !felt.type {
        %zero = felt.const 0
        scf.yield %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield %one : !felt.type
      } {product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@A>, !felt.type

      scf.if %condition {
        scf.if %condition {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        }
      } else {
        scf.if %condition {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        }
      } {product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }

  struct.def @B {
    struct.member @foo : !felt.type

    // A trapping operation inside the nested scf.if must still block movement.
    function.def @product(%condition: i1, %value: !felt.type, %lhs: index, %divisor: index) -> !struct.type<@B> attributes {function.allow_constraint, function.allow_witness} {
      %self = struct.new : <@B>

      %computed = scf.if %condition -> !felt.type {
        %zero = felt.const 0
        scf.yield %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield %one : !felt.type
      } {product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@B>, !felt.type

      scf.if %condition {
        scf.if %condition {
          %quotient = arith.divui %lhs, %divisor : index
        } else {
          %quotient = arith.divui %lhs, %divisor : index
        }
      } else {
        scf.if %condition {
          %quotient = arith.divui %lhs, %divisor : index
        } else {
          %quotient = arith.divui %lhs, %divisor : index
        }
      } {product_source = "constrain"}

      function.return %self : !struct.type<@B>
    }
  }

  struct.def @C {
    struct.member @foo : !felt.type

    // A unit-step scf.for is recursively speculatable and may move when its body is safe.
    function.def @product(%condition: i1, %value: !felt.type) -> !struct.type<@C> attributes {function.allow_constraint, function.allow_witness} {
      %self = struct.new : <@C>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index

      %computed = scf.if %condition -> !felt.type {
        %zero = felt.const 0
        scf.yield %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield %one : !felt.type
      } {product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@C>, !felt.type

      scf.if %condition {
        scf.for %i = %c0 to %c1 step %c1 {
          constrain.eq %value, %value : !felt.type
        }
      } else {
        scf.for %i = %c0 to %c1 step %c1 {
          constrain.eq %value, %value : !felt.type
        }
      } {product_source = "constrain"}

      function.return %self : !struct.type<@C>
    }
  }

  struct.def @D {
    struct.member @foo : !felt.type

    // A step other than one makes scf.for potentially non-terminating and blocks movement.
    function.def @product(%condition: i1, %value: !felt.type) -> !struct.type<@D> attributes {function.allow_constraint, function.allow_witness} {
      %self = struct.new : <@D>
      %c0 = arith.constant 0 : index
      %c1 = arith.constant 1 : index
      %c2 = arith.constant 2 : index

      %computed = scf.if %condition -> !felt.type {
        %zero = felt.const 0
        scf.yield %zero : !felt.type
      } else {
        %one = felt.const 1
        scf.yield %one : !felt.type
      } {product_source = "compute"}

      struct.writem %self[@foo] = %computed : <@D>, !felt.type

      scf.if %condition {
        scf.for %i = %c0 to %c1 step %c2 {
          constrain.eq %value, %value : !felt.type
        }
      } else {
        scf.for %i = %c0 to %c1 step %c2 {
          constrain.eq %value, %value : !felt.type
        }
      } {product_source = "constrain"}

      function.return %self : !struct.type<@D>
    }
  }
}

