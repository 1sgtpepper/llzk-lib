// RUN: llzk-opt --llzk-fuse-product-control-flow %s | FileCheck --enable-var-scope %s
// Outer if fusion makes the branch-local pairs siblings; both new branches must be revisited.

module attributes {llzk.lang = "llzk"} {
  struct.def @A {
    struct.member @foo : !felt.type

    function.def @product(%outer: i1, %inner: i1, %value: !felt.type) -> !struct.type<@A> {
      %self = struct.new : <@A>

      scf.if %outer {
        scf.if %inner {
          %then_true = felt.const 10
        } else {
          %then_false = felt.const 11
        } {product_source = "compute"}
      } else {
        scf.if %inner {
          %else_true = felt.const 20
        } else {
          %else_false = felt.const 21
        } {product_source = "compute"}
      } {product_source = "compute"}

      scf.if %outer {
        scf.if %inner {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        } {product_source = "constrain"}
      } else {
        scf.if %inner {
          constrain.eq %value, %value : !felt.type
        } else {
          constrain.eq %value, %value : !felt.type
        } {product_source = "constrain"}
      } {product_source = "constrain"}

      function.return %self : !struct.type<@A>
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang = "llzk"} {
// CHECK-NEXT:    struct.def @A {
// CHECK-NEXT:      struct.member @foo : !felt.type
// CHECK-NEXT:      function.def @product(%[[VAL_0:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_1:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_2:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@A> attributes {function.allow_constraint, function.allow_witness} {
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.new : <@A>
// CHECK-NEXT:        scf.if %[[VAL_0]] {
// CHECK-NEXT:          scf.if %[[VAL_1]] {
// CHECK-NEXT:            %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.const  10
// CHECK-NEXT:            constrain.eq %[[VAL_2]], %[[VAL_2]] : !felt.type, !felt.type
// CHECK-NEXT:          } else {
// CHECK-NEXT:            %[[VAL_5:[0-9a-zA-Z_\.]+]] = felt.const  11
// CHECK-NEXT:            constrain.eq %[[VAL_2]], %[[VAL_2]] : !felt.type, !felt.type
// CHECK-NEXT:          } {product_source = "fused"}
// CHECK-NEXT:        } else {
// CHECK-NEXT:          scf.if %[[VAL_1]] {
// CHECK-NEXT:            %[[VAL_6:[0-9a-zA-Z_\.]+]] = felt.const  20
// CHECK-NEXT:            constrain.eq %[[VAL_2]], %[[VAL_2]] : !felt.type, !felt.type
// CHECK-NEXT:          } else {
// CHECK-NEXT:            %[[VAL_7:[0-9a-zA-Z_\.]+]] = felt.const  21
// CHECK-NEXT:            constrain.eq %[[VAL_2]], %[[VAL_2]] : !felt.type, !felt.type
// CHECK-NEXT:          } {product_source = "fused"}
// CHECK-NEXT:        } {product_source = "fused"}
// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@A>
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
