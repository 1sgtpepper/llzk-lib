// RUN: split-file %s %t
// RUN: llzk-opt --verify-each -llzk-full-r1cs-lowering %t/candidate.llzk -o %t/candidate.r1cs.mlir
// RUN: llzk-opt --verify-each -llzk-full-r1cs-lowering %t/control.llzk -o %t/control.r1cs.mlir
// RUN: test "$(grep -c 'r1cs.constrain' %t/candidate.r1cs.mlir)" -eq 1
// RUN: diff -u %t/candidate.r1cs.mlir %t/control.r1cs.mlir
// RUN: FileCheck %s --input-file=%t/candidate.r1cs.mlir --check-prefix=CANDIDATE

// CANDIDATE-LABEL: r1cs.circuit @Main inputs
// CANDIDATE: r1cs.def 1 : !r1cs.signal {pub = #r1cs.pub}
// CANDIDATE: r1cs.to_linear
// CANDIDATE: r1cs.to_linear
// CANDIDATE: r1cs.constrain
// CANDIDATE-NOT: r1cs.constrain

//--- candidate.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type<"bn128"> {llzk.pub}

    function.def @compute(
      %x: !felt.type<"bn128">
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@out] = %x : !struct.type<@Main>, !felt.type<"bn128">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
      %self: !struct.type<@Main>,
      %x: !felt.type<"bn128"> {llzk.pub}
    ) {
      %zero = felt.const 0 <"bn128">
      %one = felt.const 1 <"bn128">
      %allowed = array.new %zero, %one : !array.type<2 x !felt.type<"bn128">>
      constrain.in %allowed, %x : !array.type<2 x !felt.type<"bn128">>, !felt.type<"bn128">
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"bn128">
      constrain.eq %out, %x : !felt.type<"bn128">
      function.return
    }
  }
}

//--- control.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !felt.type<"bn128"> {llzk.pub}

    function.def @compute(
      %x: !felt.type<"bn128">
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@out] = %x : !struct.type<@Main>, !felt.type<"bn128">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
      %self: !struct.type<@Main>,
      %x: !felt.type<"bn128"> {llzk.pub}
    ) {
      %out = struct.readm %self[@out] : !struct.type<@Main>, !felt.type<"bn128">
      constrain.eq %out, %x : !felt.type<"bn128">
      function.return
    }
  }
}
