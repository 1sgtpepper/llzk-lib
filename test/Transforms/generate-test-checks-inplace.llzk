//--- idempotent-source.llzk
#map = affine_map<(d0) -> (d0)>
module {
  func.func @CHECK() {
  }
}

//--- idempotent-input.llzk
#map = affine_map<(d0) -> (d0)>
module {
  func.func @CHECK() {
  }
}

//--- legacy-source.llzk
module {
  func.func @legacy() {
  }
}

LEGACY_NOTE

// CHECK-LABEL: stale

//--- legacy-input.llzk
module {
  func.func @legacy() {
  }
}

//--- failure-source.llzk
module {
  func.func @main() {
    %0 = "test.op"() : () -> i32
    %1 = "test.op"() : () -> i32
  }
}

//--- failure-input.llzk
module {
  func.func @main() {
    %0 = "test.op"() : () -> i32
    %1 = "test.op"() : () -> i32
  }
}

//--- checks
// FAILURE: X: duplicate variable name
// DIRTY: warning: refusing to modify a dirty Git worktree
// READONLY: error: source file is not writable:
// READONLYDIR: error: unable to replace source file:
// SYMLINK: warning: refusing to modify a dirty Git worktree
// SYMLINK-LINK: warning: refusing to modify a dirty Git worktree

//--- git
#!/usr/bin/env python3
import os
import sys

if len(sys.argv) != 5 or sys.argv[1] != "-C" or sys.argv[3:] != ["status", "--porcelain"]:
    raise SystemExit(2)

if not os.path.exists(os.path.join(sys.argv[2], ".git")):
    print("fatal: not a git repository (or any of the parent directories): .git", file=sys.stderr)
    raise SystemExit(128)

if os.path.exists(os.path.join(sys.argv[2], ".dirty")):
    print(" M source.llzk")
