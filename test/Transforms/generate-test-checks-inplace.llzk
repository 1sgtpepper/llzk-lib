//--- idempotent-source.llzk
#map = affine_map<(d0) -> (d0)>
module {
  // CHECK-this is an invariant comment
  func.func @CHECK() {
  }
}

//--- idempotent-input.llzk
#map = affine_map<(d0) -> (d0)>
module {
  func.func @CHECK() {
  }
}

//--- alt-source.llzk
#map = affine_map<(d0) -> (d0)>
module {
  func.func @alt() {
  }
}

//--- alt-input.llzk
#map = affine_map<(d0) -> (d0)>
module {
  func.func @alt() {
  }
}

//--- legacy-source.llzk
module {
  func.func @legacy() {
  }
}

LEGACY_NOTE

// CHECK-LABEL: stale

//--- legacy-input.llzk
module {
  func.func @legacy() {
  }
}

//--- failure-source.llzk
module {
  func.func @main() {
    %0 = "test.op"() : () -> i32
    %1 = "test.op"() : () -> i32
  }
}

//--- failure-input.llzk
module {
  func.func @main() {
    %0 = "test.op"() : () -> i32
    %1 = "test.op"() : () -> i32
  }
}

//--- git
#!/bin/sh

if [ "$#" -ne 4 ] && [ "$#" -ne 5 ]; then
    exit 2
fi
if [ "$1" != "-C" ] || [ "$3" != "status" ] || [ "$4" != "--porcelain" ]; then
    exit 2
fi

include_untracked=0
if [ "$#" -eq 5 ]; then
    if [ "$5" != "--untracked-files=all" ]; then
        exit 2
    fi
    include_untracked=1
fi

if [ ! -e "$2/.git" ]; then
    printf '%s\n' 'fatal: not a git repository (or any of the parent directories): .git' >&2
    exit 128
fi

dirty=0
if [ -e "$2/.git/clean-source.llzk" ] && ! cmp -s "$2/source.llzk" "$2/.git/clean-source.llzk"; then
    dirty=1
fi
if [ -e "$2/.dirty" ]; then
    dirty=1
fi
# Model status.showUntrackedFiles=no: only the explicit command-line override
# reports this untracked file.
if [ "$include_untracked" -eq 1 ] && [ -e "$2/.hidden-untracked" ]; then
    dirty=1
fi
if [ "$dirty" -eq 1 ]; then
    printf '%s\n' ' M source.llzk'
fi

//--- fail-replace.py
import importlib.util
import sys

script_path, source_path, input_path = sys.argv[1:]
spec = importlib.util.spec_from_file_location("generate_test_checks", script_path)
generator = importlib.util.module_from_spec(spec)
spec.loader.exec_module(generator)


def fail_replace(_source, _target):
    # Force failure after the temporary source has been created.
    raise OSError("injected replace failure")


generator.os.replace = fail_replace
sys.argv = [
    script_path,
    "--source",
    source_path,
    "--source_delim_regex=^module ",
    "--allow-dirty",
    "-i",
    input_path,
]
raise SystemExit(generator.main())

//--- checks
// These error-output assertions apply to the RUN lines rather than one split
// input, so the shared block follows the final split.
// FAILURE: X: duplicate variable name
// OUTPUT-CONFLICT: error: --inplace cannot be used with --output
// INVALID-OUTPUT: error: argument -o/--output: can't open
// DIRTY: warning: refusing to modify a dirty Git worktree
// READONLY: error: source file is not writable:
// READONLYDIR: error: unable to replace source file:
// SYMLINK: warning: refusing to modify a dirty Git worktree
// SYMLINK-LINK: warning: refusing to modify a dirty Git worktree
// REPLACE-FAILURE: error: unable to replace source file: injected replace failure
