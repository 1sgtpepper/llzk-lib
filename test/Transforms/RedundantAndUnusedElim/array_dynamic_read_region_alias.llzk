// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
  // An exclusive arm must not erase the pre-region write observed by the
  // sibling arm's surviving dynamic read.
  function.def @sibling_region_dynamic_read(%idx: index, %cond: i1) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %result = scf.if %cond -> !felt.type {
      array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
      scf.yield %two : !felt.type
    } else {
      %observed = array.read %arr[%idx] : !array.type<2 x !felt.type>, !felt.type
      scf.yield %observed : !felt.type
    }
    function.return %result : !felt.type
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @sibling_region_dynamic_read(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index, %[[VAL_1:[0-9a-zA-Z_\.]+]]: i1) -> !felt.type {
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_2]], %[[VAL_2]] : <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_5]]{{\[}}%[[VAL_6]]] = %[[VAL_3]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = scf.if %[[VAL_1]] -> (!felt.type) {
// CHECK-NEXT:        array.write %[[VAL_5]]{{\[}}%[[VAL_6]]] = %[[VAL_4]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:        scf.yield %[[VAL_4]] : !felt.type
// CHECK-NEXT:      } else {
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_5]]{{\[}}%[[VAL_0]]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:        scf.yield %[[VAL_8]] : !felt.type
// CHECK-NEXT:      }
// CHECK-NEXT:      function.return %[[VAL_7]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
