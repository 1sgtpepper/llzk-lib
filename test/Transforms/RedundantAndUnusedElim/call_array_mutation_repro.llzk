// RUN: split-file %s %t
// RUN: llzk-witgen %t/test.llzk --inputs %t/input.json --backend=interpreter | FileCheck %s

// A function argument is passed by value. Mutating an array argument in the
// callee must not change the caller's array.

//--- test.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @out : !array.type<2 x !felt.type<"babybear">> {llzk.pub}

    function.def @compute(
        %input: !array.type<2 x !felt.type<"babybear">> {function.arg_name = "input"}
    ) -> !struct.type<@Main> {
      %replacement = felt.const 2 <"babybear">
      function.call @mutate(%input, %replacement) :
          (!array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">) -> ()

      %self = struct.new : !struct.type<@Main>
      struct.writem %self[@out] = %input :
          !struct.type<@Main>, !array.type<2 x !felt.type<"babybear">>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
        %self: !struct.type<@Main>,
        %input: !array.type<2 x !felt.type<"babybear">>
    ) {
      function.return
    }
  }

  function.def @mutate(
      %array: !array.type<2 x !felt.type<"babybear">>,
      %replacement: !felt.type<"babybear">
  ) attributes {function.allow_witness} {
    %zero = arith.constant 0 : index
    array.write %array[%zero] = %replacement :
        !array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">
    function.return
  }
}

// The interpreter currently returns [2, 3] because the callee writes through
// the caller's shared array storage. The issue expects [1, 3].
// CHECK: {
// CHECK-NEXT:   "out": [
// CHECK-NEXT:     "2",
// CHECK-NEXT:     "3"
// CHECK-NEXT:   ]
// CHECK-NEXT: }

//--- input.json
{"input": [1, 3]}
