// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck %s

// The free witness function mutates its array argument from %before to %after.
// For the concrete input before=1, after=2, the public output and constraint
// must observe 2.  The current pass leaves the caller's array value tree
// unchanged and reuses %before after the call.
module attributes {llzk.lang} {
  struct.def @Caller {
    struct.member @out : !felt.type {llzk.pub}

    function.def @compute(
        %before: !felt.type, %after: !felt.type
    ) -> !struct.type<@Caller> {
      %self = struct.new : !struct.type<@Caller>
      %c0 = arith.constant 0 : index
      %array = array.new %before, %before : !array.type<2 x !felt.type>
      function.call @mutate(%array, %after) :
          (!array.type<2 x !felt.type>, !felt.type) -> ()
      %observed = array.read %array[%c0] : <2 x !felt.type>, !felt.type
      struct.writem %self[@out] = %observed : !struct.type<@Caller>, !felt.type
      function.return %self : !struct.type<@Caller>
    }

    function.def @constrain(
        %self: !struct.type<@Caller>, %before: !felt.type, %after: !felt.type
    ) {
      %out = struct.readm %self[@out] : !struct.type<@Caller>, !felt.type
      constrain.eq %out, %after : !felt.type
      function.return
    }
  }

  function.def @mutate(%array: !array.type<2 x !felt.type>, %new: !felt.type)
      attributes {function.allow_witness} {
    %c0 = arith.constant 0 : index
    array.write %array[%c0] = %new : <2 x !felt.type>, !felt.type
    function.return
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Caller {
// CHECK-NEXT:      struct.member @out : !felt.type {llzk.pub}
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Caller> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = struct.new : <@Caller>
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_0]], %[[VAL_0]] : <2 x !felt.type>
// CHECK-NEXT:        function.call @mutate(%[[VAL_4]], %[[VAL_1]]) : (!array.type<2 x !felt.type>, !felt.type) -> ()
// CHECK-NEXT:        struct.writem %[[VAL_2]][@out] = %[[VAL_0]] : <@Caller>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_2]] : !struct.type<@Caller>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_5:[0-9a-zA-Z_\.]+]]: !struct.type<@Caller>, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_7:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = struct.readm %[[VAL_5]][@out] : <@Caller>, !felt.type
// CHECK-NEXT:        constrain.eq %[[VAL_8]], %[[VAL_7]] : !felt.type, !felt.type
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @mutate(%[[VAL_9:[0-9a-zA-Z_\.]+]]: !array.type<2 x !felt.type>, %[[VAL_10:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_witness} {
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_9]]{{\[}}%[[VAL_11]]] = %[[VAL_10]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return
// CHECK-NEXT:    }
// CHECK-NEXT:  }
