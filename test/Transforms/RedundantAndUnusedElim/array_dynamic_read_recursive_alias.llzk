// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
  // A dynamic suffix can observe a write below a constant prefix, so the later
  // overwrite must not erase the earlier write.
  function.def @mixed_constant_prefix_dynamic_suffix(%idx: index) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0, %i0] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %arr[%i0, %idx] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %arr[%i0, %i0] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }

  // A dynamic extract may observe writes in the selected aggregate subtree, so
  // the later overwrite must not erase the earlier write.
  function.def @dynamic_extract_preserves_subtree_write(%idx: index) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %matrix[%i0, %i0] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %row = array.extract %matrix[%idx] : !array.type<2,2 x !felt.type>
    array.write %matrix[%i0, %i0] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %row[%i0] :
        !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @mixed_constant_prefix_dynamic_suffix(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !felt.type {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <2,2 x !felt.type>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_4]]] = %[[VAL_1]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_0]]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      array.write %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_4]]] = %[[VAL_2]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return %[[VAL_5]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @dynamic_extract_preserves_subtree_write(%[[VAL_6:[0-9a-zA-Z_\.]+]]: index) -> !felt.type {
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_8:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = array.new  : <2,2 x !felt.type>
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_9]]{{\[}}%[[VAL_10]], %[[VAL_10]]] = %[[VAL_7]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      %[[VAL_11:[0-9a-zA-Z_\.]+]] = array.extract %[[VAL_9]]{{\[}}%[[VAL_6]]] : <2,2 x !felt.type>
// CHECK-NEXT:      array.write %[[VAL_9]]{{\[}}%[[VAL_10]], %[[VAL_10]]] = %[[VAL_8]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      %[[VAL_12:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_11]]{{\[}}%[[VAL_10]]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return %[[VAL_12]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
