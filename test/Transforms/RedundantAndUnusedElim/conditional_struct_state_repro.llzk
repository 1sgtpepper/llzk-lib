// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck %s

// The write in scf.if is conditional.  The pass propagates the branch's
// struct-member tree after the region instead of intersecting it with the
// pre-branch state, so the later read is replaced by %after even when the
// condition is false.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type
    struct.member @out : !felt.type

    function.def @compute(
        %cond: i1, %before: !felt.type, %after: !felt.type
    ) -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      struct.writem %self[@value] = %before : !struct.type<@Cell>, !felt.type
      scf.if %cond {
        struct.writem %self[@value] = %after : !struct.type<@Cell>, !felt.type
      }
      %observed = struct.readm %self[@value] : !struct.type<@Cell>, !felt.type
      struct.writem %self[@out] = %observed : !struct.type<@Cell>, !felt.type
      function.return %self : !struct.type<@Cell>
    }

    function.def @constrain(
        %self: !struct.type<@Cell>, %cond: i1, %before: !felt.type, %after: !felt.type
    ) {
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @Cell {
// CHECK-NEXT:      struct.member @value : !felt.type
// CHECK-NEXT:      struct.member @out : !felt.type
// CHECK-NEXT:      function.def @compute(%[[VAL_0:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_1:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_2:[0-9a-zA-Z_\.]+]]: !felt.type) -> !struct.type<@Cell> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = struct.new : <@Cell>
// CHECK-NEXT:        scf.if %[[VAL_0]] {
// CHECK-NEXT:          struct.writem %[[VAL_3]][@value] = %[[VAL_2]] : <@Cell>, !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:        struct.writem %[[VAL_3]][@out] = %[[VAL_2]] : <@Cell>, !felt.type
// CHECK-NEXT:        function.return %[[VAL_3]] : !struct.type<@Cell>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_4:[0-9a-zA-Z_\.]+]]: !struct.type<@Cell>, %[[VAL_5:[0-9a-zA-Z_\.]+]]: i1, %[[VAL_6:[0-9a-zA-Z_\.]+]]: !felt.type, %[[VAL_7:[0-9a-zA-Z_\.]+]]: !felt.type) attributes {function.allow_constraint} {
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// CHECK-NEXT:  /build/source/test/Transforms/RedundantAndUnusedElim/conditional_struct_state_repro.llzk:39:11: error: CHECK: expected string not found in input
