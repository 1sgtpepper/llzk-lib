// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck %s

// The child constrain function mutates its struct argument.  The call is an
// effect barrier for global/RAM facts, but the current pass leaves the
// caller's struct-member tree unchanged and reuses %before after the call.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}

    function.def @compute(%initial: !felt.type) -> !struct.type<@Cell> {
      %self = struct.new : !struct.type<@Cell>
      struct.writem %self[@value] = %initial : !struct.type<@Cell>, !felt.type
      function.return %self : !struct.type<@Cell>
    }

    function.def @constrain(%self: !struct.type<@Cell>, %new: !felt.type) {
      struct.writem %self[@value] = %new : !struct.type<@Cell>, !felt.type
      function.return
    }
  }

  struct.def @Caller {
    struct.member @child : !struct.type<@Cell>

    function.def @compute(%initial: !felt.type) -> !struct.type<@Caller> {
      %self = struct.new : !struct.type<@Caller>
      %child = function.call @Cell::@compute(%initial) :
          (!felt.type) -> !struct.type<@Cell>
      struct.writem %self[@child] = %child :
          !struct.type<@Caller>, !struct.type<@Cell>
      function.return %self : !struct.type<@Caller>
    }

    function.def @constrain(%self: !struct.type<@Caller>, %after: !felt.type) {
      %child = struct.readm %self[@child] :
          !struct.type<@Caller>, !struct.type<@Cell>
      %before = struct.readm %child[@value] : !struct.type<@Cell>, !felt.type
      function.call @Cell::@constrain(%child, %after) :
          (!struct.type<@Cell>, !felt.type) -> ()
      %observed = struct.readm %child[@value] : !struct.type<@Cell>, !felt.type
      constrain.eq %observed, %after : !felt.type
      function.return
    }
  }
}

// CHECK-LABEL: struct.def @Caller {
// CHECK:       function.def @constrain(
// CHECK:       function.call @Cell::@constrain
// CHECK-NOT:   struct.readm %{{.*}}[@value]
// CHECK:       constrain.eq %{{.*}}, %{{.*}} : !felt.type, !felt.type
