// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck %s

// The free witness function mutates its struct argument.  The call is an
// effect barrier for global/RAM facts, but the current pass leaves the
// caller's struct-member tree unchanged and reuses %before after the call.
module attributes {llzk.lang} {
  struct.def @Cell {
    struct.member @value : !felt.type {llzk.pub}
    struct.member @out : !felt.type {llzk.pub}
  }

  function.def @mutate(%self: !struct.type<@Cell>, %new: !felt.type)
      attributes {function.allow_witness} {
    struct.writem %self[@value] = %new : !struct.type<@Cell>, !felt.type
    function.return
  }

  function.def @caller(
      %before: !felt.type, %after: !felt.type
  ) -> !struct.type<@Cell> attributes {function.allow_witness} {
    %self = struct.new : !struct.type<@Cell>
    struct.writem %self[@value] = %before : !struct.type<@Cell>, !felt.type
    function.call @mutate(%self, %after) : (!struct.type<@Cell>, !felt.type) -> ()
    %observed = struct.readm %self[@value] : !struct.type<@Cell>, !felt.type
    struct.writem %self[@out] = %observed : !struct.type<@Cell>, !felt.type
    function.return %self : !struct.type<@Cell>
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK:       function.def @caller(
// CHECK:       function.call @mutate
// CHECK-NOT:   struct.readm %{{.*}}[@value]
// CHECK:       struct.writem %{{.*}}[@out] = %{{.*}}
