// RUN: llzk-opt -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck %s

// A loop executes its body more than once.  The array contains %first on the
// first iteration, but the body writes %second before the next iteration.
// The pass carries the pre-loop array tree into the body and removes the read
// as if the initial element were invariant across iterations.
module attributes {llzk.lang} {
  struct.def @LoopState {
    struct.member @out : !felt.type

    function.def @compute() -> !struct.type<@LoopState> {
      %self = struct.new : !struct.type<@LoopState>
      function.return %self : !struct.type<@LoopState>
    }

    function.def @constrain(%self: !struct.type<@LoopState>) {
      %first = felt.const 1
      %second = felt.const 2
      %expected = felt.const 1
      %arr = array.new %first, %first : !array.type<2 x !felt.type>
      %zero = arith.constant 0 : index
      %lb = arith.constant 0 : index
      %ub = arith.constant 2 : index
      %step = arith.constant 1 : index
      scf.for %iv = %lb to %ub step %step {
        %observed = array.read %arr[%zero] : !array.type<2 x !felt.type>, !felt.type
        constrain.eq %observed, %expected : !felt.type
        array.write %arr[%zero] = %second : !array.type<2 x !felt.type>, !felt.type
      }
      function.return
    }
  }
}

// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    struct.def @LoopState {
// CHECK-NEXT:      struct.member @out : !felt.type
// CHECK-NEXT:      function.def @compute() -> !struct.type<@LoopState> attributes {function.allow_witness} {
// CHECK-NEXT:        %[[VAL_0:[0-9a-zA-Z_\.]+]] = struct.new : <@LoopState>
// CHECK-NEXT:        function.return %[[VAL_0]] : !struct.type<@LoopState>
// CHECK-NEXT:      }
// CHECK-NEXT:      function.def @constrain(%[[VAL_1:[0-9a-zA-Z_\.]+]]: !struct.type<@LoopState>) attributes {function.allow_constraint} {
// CHECK-NEXT:        %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:        %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_2]], %[[VAL_2]] : <2 x !felt.type>
// CHECK-NEXT:        %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_7:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:        %[[VAL_8:[0-9a-zA-Z_\.]+]] = arith.constant 2 : index
// CHECK-NEXT:        %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:        scf.for %[[VAL_10:[0-9a-zA-Z_\.]+]] = %[[VAL_7]] to %[[VAL_8]] step %[[VAL_9]] {
// CHECK-NEXT:          constrain.eq %[[VAL_2]], %[[VAL_4]] : !felt.type, !felt.type
// CHECK-NEXT:          array.write %[[VAL_5]]{{\[}}%[[VAL_6]]] = %[[VAL_3]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:        }
// CHECK-NEXT:        function.return
// CHECK-NEXT:      }
// CHECK-NEXT:    }
// CHECK-NEXT:  }
