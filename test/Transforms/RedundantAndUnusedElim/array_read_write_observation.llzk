// RUN: llzk-opt -split-input-file -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck --enable-var-scope %s

module attributes {llzk.lang} {
  // A live dynamic read may observe the first constant-index write.
  function.def @live_dynamic_read_preserves_prior_constant_write(
      %idx: index
  ) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = array.read %arr[%idx] : !array.type<2 x !felt.type>, !felt.type
    array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @live_dynamic_read_preserves_prior_constant_write(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !felt.type {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_1]], %[[VAL_1]] : <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_4]]{{\[}}%[[VAL_5]]] = %[[VAL_2]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_4]]{{\[}}%[[VAL_0]]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      array.write %[[VAL_4]]{{\[}}%[[VAL_5]]] = %[[VAL_3]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return %[[VAL_6]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----
module attributes {llzk.lang} {
  // A read replaced by a known SSA value is not a runtime observation.
  function.def @known_read_does_not_block_overwrite_elimination() -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = array.read %arr[%i0] : !array.type<2 x !felt.type>, !felt.type
    array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @known_read_does_not_block_overwrite_elimination() -> !felt.type {
// CHECK-NEXT:      %[[VAL_0:[0-9a-zA-Z_\.]+]] = felt.const  0
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_0]], %[[VAL_0]] : <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_3]]{{\[}}%[[VAL_4]]] = %[[VAL_2]] : <2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return %[[VAL_1]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----
module attributes {llzk.lang} {
  // [row,0] cannot observe [0,1], so the disjoint overwrite remains removable.
  function.def @dynamic_read_preserves_disjoint_suffix_elimination(
      %row: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    array.write %matrix[%i0, %i1] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %matrix[%row, %i0] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %matrix[%i0, %i1] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @dynamic_read_preserves_disjoint_suffix_elimination(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !felt.type {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <2,2 x !felt.type>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = arith.constant 1 : index
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_3]]{{\[}}%[[VAL_0]], %[[VAL_4]]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      array.write %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_5]]] = %[[VAL_2]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return %[[VAL_6]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----
module attributes {llzk.lang} {
  // Detaching a dynamic aggregate alias must clear candidates shared with its source.
  function.def @dynamic_alias_detached_by_constant_write_preserves_source_candidate(
      %idx: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %row = array.new : !array.type<2 x !felt.type>
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    array.write %row[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    array.insert %matrix[%idx] = %row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    array.write %matrix[%i1, %i1] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %matrix[%i0, %i0] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %row[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// -----
module attributes {llzk.lang} {
  // Detaching a constant aggregate alias must clear candidates shared with its source.
  function.def @constant_alias_detached_by_dynamic_write_preserves_source_candidate(
      %idx: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %row = array.new : !array.type<2 x !felt.type>
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    array.write %row[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    array.insert %matrix[%i0] = %row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    array.write %matrix[%idx, %i1] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %matrix[%i0, %i0] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %row[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// -----
module attributes {llzk.lang} {
  // The scalar read may observe a value supplied by the earlier row insert.
  function.def @dynamic_suffix_read_preserves_prior_insert(
      %col: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %first_row = array.new %one, %one : !array.type<2 x !felt.type>
    %second_row = array.new %two, %two : !array.type<2 x !felt.type>
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.insert %matrix[%i0] = %first_row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    %observed = array.read %matrix[%i0, %col] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.insert %matrix[%i0] = %second_row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    function.return %observed : !felt.type
  }
}
