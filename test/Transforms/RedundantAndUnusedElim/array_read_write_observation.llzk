module attributes {llzk.lang} {
  struct.def @BranchElement {
    struct.member @value : !felt.type
    struct.member @result : !felt.type
    // A write in one branch cannot delete a pre-branch write observed through
    // the opposite branch.
    function.def @compute(
        %idx: index, %cond: i1
    ) -> !struct.type<@BranchElement> {
      %self = struct.new : !struct.type<@BranchElement>
      %one = felt.const 1
      %two = felt.const 2
      struct.writem %self[@value] = %one :
          !struct.type<@BranchElement>, !felt.type
      %arr = array.new %self, %self :
          !array.type<2 x !struct.type<@BranchElement>>
      %observed = scf.if %cond -> !felt.type {
        struct.writem %self[@value] = %two :
            !struct.type<@BranchElement>, !felt.type
        scf.yield %two : !felt.type
      } else {
        %selected = array.read %arr[%idx] :
            !array.type<2 x !struct.type<@BranchElement>>,
            !struct.type<@BranchElement>
        %branch_observed = struct.readm %selected[@value] :
            !struct.type<@BranchElement>, !felt.type
        scf.yield %branch_observed : !felt.type
      }
      struct.writem %self[@result] = %observed :
          !struct.type<@BranchElement>, !felt.type
      function.return %self : !struct.type<@BranchElement>
    }
    function.def @constrain(
        %self: !struct.type<@BranchElement>, %idx: index, %cond: i1
    ) { function.return }
  }
}
