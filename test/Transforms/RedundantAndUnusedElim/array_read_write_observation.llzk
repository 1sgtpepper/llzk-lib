// CHECK-NEXT:    function.def @dynamic_suffix_read_preserves_prior_insert(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !felt.type {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_1]], %[[VAL_1]] : <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = array.new %[[VAL_2]], %[[VAL_2]] : <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.new  : <2,2 x !felt.type>
// CHECK-NEXT:      %[[VAL_6:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.insert %[[VAL_5]]{{\[}}%[[VAL_6]]] = %[[VAL_3]] : <2,2 x !felt.type>, <2 x !felt.type>
// CHECK-NEXT:      %[[VAL_7:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_5]]{{\[}}%[[VAL_6]], %[[VAL_0]]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      array.insert %[[VAL_5]]{{\[}}%[[VAL_6]]] = %[[VAL_4]] : <2,2 x !felt.type>, <2 x !felt.type>
// CHECK-NEXT:      function.return %[[VAL_7]] : !felt.type
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----
module attributes {llzk.lang} {
  // Extracting a row observes tracked writes in the selected subtree.
  function.def @dynamic_extract_preserves_prior_descendant_write(
      %row: index
  ) -> !array.type<2 x !felt.type> {
    %one = felt.const 1
    %two = felt.const 2
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %matrix[%i0, %i0] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.extract %matrix[%row] : !array.type<2,2 x !felt.type>
    array.write %matrix[%i0, %i0] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    function.return %observed : !array.type<2 x !felt.type>
  }
}
// CHECK-LABEL: module attributes {llzk.lang} {
// CHECK-NEXT:    function.def @dynamic_extract_preserves_prior_descendant_write(%[[VAL_0:[0-9a-zA-Z_\.]+]]: index) -> !array.type<2 x !felt.type> {
// CHECK-NEXT:      %[[VAL_1:[0-9a-zA-Z_\.]+]] = felt.const  1
// CHECK-NEXT:      %[[VAL_2:[0-9a-zA-Z_\.]+]] = felt.const  2
// CHECK-NEXT:      %[[VAL_3:[0-9a-zA-Z_\.]+]] = array.new  : <2,2 x !felt.type>
// CHECK-NEXT:      %[[VAL_4:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      array.write %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_4]]] = %[[VAL_1]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      %[[VAL_5:[0-9a-zA-Z_\.]+]] = array.extract %[[VAL_3]]{{\[}}%[[VAL_0]]] : <2,2 x !felt.type>
// CHECK-NEXT:      array.write %[[VAL_3]]{{\[}}%[[VAL_4]], %[[VAL_4]]] = %[[VAL_2]] : <2,2 x !felt.type>, !felt.type
// CHECK-NEXT:      function.return %[[VAL_5]] : !array.type<2 x !felt.type>
// CHECK-NEXT:    }
// CHECK-NEXT:  }
// -----
module attributes {llzk.lang} {
  struct.def @Element {
    struct.member @value : !felt.type
    struct.member @result : !felt.type
    // array.read can return an aggregate, so the selected member subtree is live.
    function.def @compute(%idx: index) -> !struct.type<@Element> {
      %self = struct.new : !struct.type<@Element>
      %one = felt.const 1
      %two = felt.const 2
      struct.writem %self[@value] = %one : !struct.type<@Element>, !felt.type
      %arr = array.new %self, %self : !array.type<2 x !struct.type<@Element>>
      %selected = array.read %arr[%idx] :
          !array.type<2 x !struct.type<@Element>>, !struct.type<@Element>
      %observed = struct.readm %selected[@value] :
          !struct.type<@Element>, !felt.type
      struct.writem %self[@value] = %two : !struct.type<@Element>, !felt.type
      struct.writem %self[@result] = %observed : !struct.type<@Element>, !felt.type
      function.return %self : !struct.type<@Element>
    }
    function.def @constrain(%self: !struct.type<@Element>, %idx: index) { function.return }
  }
}
