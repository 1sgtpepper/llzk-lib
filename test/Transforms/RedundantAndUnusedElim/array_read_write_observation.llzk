// RUN: llzk-opt -split-input-file -llzk-duplicate-read-write-elim %s 2>&1 | FileCheck %s

module attributes {llzk.lang} {
  // A live dynamic read may observe the first constant-index write.
  function.def @live_dynamic_read_preserves_prior_constant_write(
      %idx: index
  ) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = array.read %arr[%idx] : !array.type<2 x !felt.type>, !felt.type
    array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: function.def @live_dynamic_read_preserves_prior_constant_write
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[ARR:.*]] = array.new
// CHECK: %[[I0:.*]] = arith.constant 0 : index
// CHECK: array.write %[[ARR]]{{\[}}%[[I0]]] = %[[ONE]]
// CHECK: %[[OBSERVED:.*]] = array.read %[[ARR]]
// CHECK: array.write %[[ARR]]{{\[}}%[[I0]]] = %[[TWO]]
// CHECK: function.return %[[OBSERVED]]

// -----

module attributes {llzk.lang} {
  // A read replaced by a known SSA value is not a runtime observation.
  function.def @known_read_does_not_block_overwrite_elimination() -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = array.read %arr[%i0] : !array.type<2 x !felt.type>, !felt.type
    array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: function.def @known_read_does_not_block_overwrite_elimination
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[ARR:.*]] = array.new
// CHECK: %[[I0:.*]] = arith.constant 0 : index
// CHECK-NOT: array.write %[[ARR]]{{\[}}%[[I0]]] = %[[ONE]]
// CHECK-NOT: array.read %[[ARR]]
// CHECK: array.write %[[ARR]]{{\[}}%[[I0]]] = %[[TWO]]
// CHECK: function.return %[[ONE]]

// -----

module attributes {llzk.lang} {
  // [row,0] cannot observe [0,1], so the disjoint overwrite remains removable.
  function.def @dynamic_read_preserves_disjoint_suffix_elimination(
      %row: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    %i1 = arith.constant 1 : index
    array.write %matrix[%i0, %i1] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.read %matrix[%row, %i0] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.write %matrix[%i0, %i1] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: function.def @dynamic_read_preserves_disjoint_suffix_elimination
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[MATRIX:.*]] = array.new
// CHECK: %[[I0:.*]] = arith.constant 0 : index
// CHECK: %[[I1:.*]] = arith.constant 1 : index
// CHECK-NOT: array.write %[[MATRIX]]{{\[}}%[[I0]], %[[I1]]] = %[[ONE]]
// CHECK: %[[OBSERVED:.*]] = array.read %[[MATRIX]]
// CHECK: array.write %[[MATRIX]]{{\[}}%[[I0]], %[[I1]]] = %[[TWO]]
// CHECK: function.return %[[OBSERVED]]

// -----

module attributes {llzk.lang} {
  // The scalar read may observe a value supplied by the earlier row insert.
  function.def @dynamic_suffix_read_preserves_prior_insert(
      %col: index
  ) -> !felt.type {
    %one = felt.const 1
    %two = felt.const 2
    %first_row = array.new %one, %one : !array.type<2 x !felt.type>
    %second_row = array.new %two, %two : !array.type<2 x !felt.type>
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.insert %matrix[%i0] = %first_row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    %observed = array.read %matrix[%i0, %col] :
        !array.type<2,2 x !felt.type>, !felt.type
    array.insert %matrix[%i0] = %second_row :
        !array.type<2,2 x !felt.type>, !array.type<2 x !felt.type>
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: function.def @dynamic_suffix_read_preserves_prior_insert
// CHECK: %[[FIRST_ROW:.*]] = array.new
// CHECK: %[[SECOND_ROW:.*]] = array.new
// CHECK: %[[MATRIX:.*]] = array.new
// CHECK: %[[I0:.*]] = arith.constant 0 : index
// CHECK: array.insert %[[MATRIX]]{{\[}}%[[I0]]] = %[[FIRST_ROW]]
// CHECK: %[[OBSERVED:.*]] = array.read %[[MATRIX]]
// CHECK: array.insert %[[MATRIX]]{{\[}}%[[I0]]] = %[[SECOND_ROW]]
// CHECK: function.return %[[OBSERVED]]

// -----

module attributes {llzk.lang} {
  // Extracting a row observes tracked writes in the selected subtree.
  function.def @dynamic_extract_preserves_prior_descendant_write(
      %row: index
  ) -> !array.type<2 x !felt.type> {
    %one = felt.const 1
    %two = felt.const 2
    %matrix = array.new : !array.type<2,2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %matrix[%i0, %i0] = %one :
        !array.type<2,2 x !felt.type>, !felt.type
    %observed = array.extract %matrix[%row] : !array.type<2,2 x !felt.type>
    array.write %matrix[%i0, %i0] = %two :
        !array.type<2,2 x !felt.type>, !felt.type
    function.return %observed : !array.type<2 x !felt.type>
  }
}
// CHECK-LABEL: function.def @dynamic_extract_preserves_prior_descendant_write
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[MATRIX:.*]] = array.new
// CHECK: %[[I0:.*]] = arith.constant 0 : index
// CHECK: array.write %[[MATRIX]]{{\[}}%[[I0]], %[[I0]]] = %[[ONE]]
// CHECK: %[[OBSERVED:.*]] = array.extract %[[MATRIX]]
// CHECK: array.write %[[MATRIX]]{{\[}}%[[I0]], %[[I0]]] = %[[TWO]]
// CHECK: function.return %[[OBSERVED]]

// -----

module attributes {llzk.lang} {
  struct.def @Element {
    struct.member @value : !felt.type
    function.def @compute() -> !struct.type<@Element> {
      %self = struct.new : !struct.type<@Element>
      function.return %self : !struct.type<@Element>
    }
    function.def @constrain(%self: !struct.type<@Element>) { function.return }
    // array.read can return an aggregate, so the selected member subtree is live.
    function.def @live_dynamic_struct_read_preserves_member_write(
        %idx: index
    ) -> !felt.type attributes {function.allow_witness} {
      %one = felt.const 1
      %two = felt.const 2
      %first = struct.new : !struct.type<@Element>
      %second = struct.new : !struct.type<@Element>
      struct.writem %first[@value] = %one : !struct.type<@Element>, !felt.type
      %arr = array.new %first, %second : !array.type<2 x !struct.type<@Element>>
      %selected = array.read %arr[%idx] :
          !array.type<2 x !struct.type<@Element>>, !struct.type<@Element>
      %observed = struct.readm %selected[@value] :
          !struct.type<@Element>, !felt.type
      struct.writem %first[@value] = %two : !struct.type<@Element>, !felt.type
      function.return %observed : !felt.type
    }
  }
}
// CHECK-LABEL: function.def @live_dynamic_struct_read_preserves_member_write
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[FIRST:.*]] = struct.new
// CHECK: %[[SECOND:.*]] = struct.new
// CHECK: struct.writem %[[FIRST]][@value] = %[[ONE]]
// CHECK: %[[ARR:.*]] = array.new %[[FIRST]], %[[SECOND]]
// CHECK: %[[SELECTED:.*]] = array.read %[[ARR]]
// CHECK: %[[OBSERVED:.*]] = struct.readm %[[SELECTED]][@value]
// CHECK: struct.writem %[[FIRST]][@value] = %[[TWO]]
// CHECK: function.return %[[OBSERVED]]

// -----

module attributes {llzk.lang} {
  // A write in one branch cannot delete a pre-branch write observed by the
  // opposite branch.
  function.def @opposite_branch_read_preserves_prior_write(
      %idx: index, %cond: i1
  ) -> !felt.type {
    %zero = felt.const 0
    %one = felt.const 1
    %two = felt.const 2
    %arr = array.new %zero, %zero : !array.type<2 x !felt.type>
    %i0 = arith.constant 0 : index
    array.write %arr[%i0] = %one : !array.type<2 x !felt.type>, !felt.type
    %observed = scf.if %cond -> !felt.type {
      array.write %arr[%i0] = %two : !array.type<2 x !felt.type>, !felt.type
      scf.yield %two : !felt.type
    } else {
      %branch_observed = array.read %arr[%idx] :
          !array.type<2 x !felt.type>, !felt.type
      scf.yield %branch_observed : !felt.type
    }
    function.return %observed : !felt.type
  }
}
// CHECK-LABEL: function.def @opposite_branch_read_preserves_prior_write
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[ARR:.*]] = array.new
// CHECK: %[[I0:.*]] = arith.constant 0 : index
// CHECK: array.write %[[ARR]]{{\[}}%[[I0]]] = %[[ONE]]
// CHECK: scf.if
// CHECK: array.write %[[ARR]]{{\[}}%[[I0]]] = %[[TWO]]
// CHECK: array.read %[[ARR]]
// -----

module attributes {llzk.lang} {
  struct.def @BranchElement {
    struct.member @value : !felt.type
    function.def @compute() -> !struct.type<@BranchElement> {
      %self = struct.new : !struct.type<@BranchElement>
      function.return %self : !struct.type<@BranchElement>
    }
    function.def @constrain(%self: !struct.type<@BranchElement>) { function.return }
    // Member-write candidates are block-local too: a write in one branch cannot
    // delete a pre-branch member write observed through the opposite branch.
    function.def @opposite_branch_struct_read_preserves_member_write(
        %idx: index, %cond: i1
    ) -> !felt.type attributes {function.allow_witness} {
      %one = felt.const 1
      %two = felt.const 2
      %first = struct.new : !struct.type<@BranchElement>
      %second = struct.new : !struct.type<@BranchElement>
      struct.writem %first[@value] = %one :
          !struct.type<@BranchElement>, !felt.type
      %arr = array.new %first, %second :
          !array.type<2 x !struct.type<@BranchElement>>
      %observed = scf.if %cond -> !felt.type {
        struct.writem %first[@value] = %two :
            !struct.type<@BranchElement>, !felt.type
        scf.yield %two : !felt.type
      } else {
        %selected = array.read %arr[%idx] :
            !array.type<2 x !struct.type<@BranchElement>>,
            !struct.type<@BranchElement>
        %branch_observed = struct.readm %selected[@value] :
            !struct.type<@BranchElement>, !felt.type
        scf.yield %branch_observed : !felt.type
      }
      function.return %observed : !felt.type
    }
  }
}
// CHECK-LABEL: function.def @opposite_branch_struct_read_preserves_member_write
// CHECK: %[[ONE:.*]] = felt.const{{ +}}1
// CHECK: %[[TWO:.*]] = felt.const{{ +}}2
// CHECK: %[[FIRST:.*]] = struct.new
// CHECK: %[[SECOND:.*]] = struct.new
// CHECK: struct.writem %[[FIRST]][@value] = %[[ONE]]
// CHECK: %[[ARR:.*]] = array.new %[[FIRST]], %[[SECOND]]
// CHECK: scf.if
// CHECK: struct.writem %[[FIRST]][@value] = %[[TWO]]
// CHECK: array.read %[[ARR]]
// CHECK: struct.readm
