// CHECK-NEXT:        %[[VAL_4:[0-9a-zA-Z_\.]+]] = poly.read_const @B : i1
// CHECK-NEXT:        %[[VAL_5:[0-9a-zA-Z_\.]+]] = function.call @full_rollback_inner(%[[VAL_3]]) : (!array.type<@N,@M x !poly.tvar<@T>>) -> !poly.tvar<@T>
// CHECK-NEXT:        function.return %[[VAL_5]] : !poly.tvar<@T>
