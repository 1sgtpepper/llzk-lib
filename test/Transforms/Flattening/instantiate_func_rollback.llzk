// CHECK-NEXT:      function.return %[[VAL_7]] : i1
// CHECK-NEXT:    }
// CHECK-NEXT:    function.def @partial_rollback_inner(%[[VAL_8:[0-9a-zA-Z_\.]+]]: !array.type<8,9 x !felt.type<"bn128">>) -> !felt.type<"bn128"> {
// CHECK-NEXT:      %[[VAL_9:[0-9a-zA-Z_\.]+]] = arith.constant 0 : index
// CHECK-NEXT:      %[[VAL_10:[0-9a-zA-Z_\.]+]] = array.read %[[VAL_8]]{{\[}}%[[VAL_9]], %[[VAL_9]]] : <8,9 x !felt.type<"bn128">>, !felt.type<"bn128">
