// RUN: split-file %s %t
// RUN: llzk-witgen %t/member.llzk --inputs %t/member-input.json --check-output %t/member-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-opt -llzk-array-to-scalar %t/member.llzk -o %t/member-scalarized.llzk
// RUN: llzk-witgen %t/member-scalarized.llzk --inputs %t/member-input.json --check-output %t/member-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-witgen %t/member-scalarized.llzk --inputs %t/member-input.json --backend=execution-engine --check-output %t/member-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-opt -llzk-duplicate-read-write-elim %t/member.llzk -o %t/member-optimized.llzk
// RUN: llzk-witgen %t/member-optimized.llzk --inputs %t/member-input.json --check-output %t/member-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-opt -llzk-array-to-scalar %t/member-optimized.llzk -o %t/member-optimized-scalarized.llzk
// RUN: llzk-witgen %t/member-optimized-scalarized.llzk --inputs %t/member-input.json --check-output %t/member-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-witgen %t/member-optimized-scalarized.llzk --inputs %t/member-input.json --backend=execution-engine --check-output %t/member-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-witgen %t/partial.llzk --inputs %t/partial-input.json --check-output %t/partial-expected.json | FileCheck %s --check-prefix=SUCCESS
// RUN: llzk-opt -llzk-duplicate-read-write-elim %t/partial.llzk -o %t/partial-optimized.llzk
// RUN: llzk-witgen %t/partial-optimized.llzk --inputs %t/partial-input.json --check-output %t/partial-expected.json | FileCheck %s --check-prefix=SUCCESS

// Original and optimized execution must match the same expected witness.
// SUCCESS: output matched expected JSON

//--- member.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @row : !array.type<2 x !felt.type<"babybear">>
    struct.member @result : !felt.type<"babybear"> {llzk.pub}

    function.def @compute(
        %selector: !felt.type<"babybear"> {function.arg_name = "selector"}
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %one = felt.const 1 <"babybear">
      %two = felt.const 2 <"babybear">
      %i0 = arith.constant 0 : index
      %i1 = arith.constant 1 : index
      %cond = bool.cmp eq(%selector, %one) :
          !felt.type<"babybear">, !felt.type<"babybear">
      %idx = scf.if %cond -> index {
        scf.yield %i1 : index
      } else {
        scf.yield %i0 : index
      }
      %row1 = array.new %one, %one : !array.type<2 x !felt.type<"babybear">>
      %row2 = array.new %two, %two : !array.type<2 x !felt.type<"babybear">>
      struct.writem %self[@row] = %row1 :
          !struct.type<@Main>, !array.type<2 x !felt.type<"babybear">>
      %copy = struct.readm %self[@row] :
          !struct.type<@Main>, !array.type<2 x !felt.type<"babybear">>
      struct.writem %self[@row] = %row2 :
          !struct.type<@Main>, !array.type<2 x !felt.type<"babybear">>
      %observed = array.read %copy[%idx] :
          !array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">
      struct.writem %self[@result] = %observed :
          !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
        %self: !struct.type<@Main>, %selector: !felt.type<"babybear">
    ) { function.return }
  }
}

//--- member-input.json
{"selector": 1}

//--- member-expected.json
{"result": "1"}

//--- partial.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Main {
    struct.member @result : !felt.type<"babybear"> {llzk.pub}

    function.def @compute(
        %first_selector: !felt.type<"babybear"> {function.arg_name = "first_selector"},
        %second_selector: !felt.type<"babybear"> {function.arg_name = "second_selector"}
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %one = felt.const 1 <"babybear">
      %two = felt.const 2 <"babybear">
      %i0 = arith.constant 0 : index
      %first_cond = bool.cmp eq(%first_selector, %one) :
          !felt.type<"babybear">, !felt.type<"babybear">
      %second_cond = bool.cmp eq(%second_selector, %one) :
          !felt.type<"babybear">, !felt.type<"babybear">
      %row = array.new : !array.type<2 x !felt.type<"babybear">>
      %matrix = array.new : !array.type<1,2 x !felt.type<"babybear">>
      scf.if %first_cond {
        array.write %row[%i0] = %one :
            !array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">
        scf.yield
      } else {
        array.write %row[%i0] = %two :
            !array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">
        scf.yield
      }
      array.insert %matrix[%i0] = %row :
          !array.type<1,2 x !felt.type<"babybear">>,
          !array.type<2 x !felt.type<"babybear">>
      scf.if %second_cond {
        array.write %row[%i0] = %one :
            !array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">
        scf.yield
      } else {
        array.write %row[%i0] = %two :
            !array.type<2 x !felt.type<"babybear">>, !felt.type<"babybear">
        scf.yield
      }
      array.insert %matrix[%i0] = %row :
          !array.type<1,2 x !felt.type<"babybear">>,
          !array.type<2 x !felt.type<"babybear">>
      %observed = array.read %matrix[%i0, %i0] :
          !array.type<1,2 x !felt.type<"babybear">>, !felt.type<"babybear">
      struct.writem %self[@result] = %observed :
          !struct.type<@Main>, !felt.type<"babybear">
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
        %self: !struct.type<@Main>,
        %first_selector: !felt.type<"babybear">,
        %second_selector: !felt.type<"babybear">
    ) { function.return }
  }
}

//--- partial-input.json
{"first_selector": 1, "second_selector": 0}

//--- partial-expected.json
{"result": "2"}
