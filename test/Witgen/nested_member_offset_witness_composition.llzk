// RUN: split-file %s %t
// RUN: llzk-opt --verify-each -llzk-full-struct-inlining %t/candidate.llzk -o %t/candidate.inline.mlir
// RUN: llzk-opt --verify-each -llzk-full-struct-inlining %t/control.llzk -o %t/control.inline.mlir
// RUN: llzk-witgen %t/candidate.inline.mlir --inputs %t/input.json --output-scope=full-witness --output-wtns %t/candidate.wtns > %t/candidate.witness.json
// RUN: llzk-witgen %t/control.inline.mlir --inputs %t/input.json --output-scope=full-witness --output-wtns %t/control.wtns > %t/control.witness.json
// RUN: diff -u %t/candidate.witness.json %t/control.witness.json
// RUN: test -s %t/candidate.wtns
// RUN: test -s %t/control.wtns
// RUN: od -An -v -t x1 %t/candidate.wtns | tr -d ' \n' | FileCheck %s --check-prefix=WTNS
// RUN: test 7 -ne 1
// RUN: llzk-opt --verify-each -llzk-full-r1cs-lowering %t/candidate.llzk -o %t/candidate.r1cs.mlir
// RUN: llzk-translate --r1cs-to-binary --r1cs-prime=21888242871839275222246405745257275088548364400416034343698204186575808495617 %t/candidate.r1cs.mlir -o %t/candidate.r1cs
// RUN: test -s %t/candidate.r1cs
// RUN: FileCheck %s --input-file=%t/candidate.witness.json --check-prefix=WITNESS
// RUN: FileCheck %s --input-file=%t/candidate.r1cs.mlir --check-prefix=R1CS

// WITNESS: "inputs": {
// WITNESS: "v": "1"
// WITNESS: "signals": {
// WITNESS: "child:!s<@Child>+x": "1"
// WTNS: 77746e73
// R1CS-LABEL: r1cs.circuit @Main inputs (%arg0
// R1CS: r1cs.def 1
// R1CS: r1cs.constrain

//--- candidate.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Child {
    struct.member @x : !felt.type<"bn128"> {column, llzk.pub}

    function.def @compute(
      %v: !felt.type<"bn128"> {function.arg_name = "v"}
    ) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      struct.writem %self[@x] = %v :
          !struct.type<@Child>, !felt.type<"bn128">
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(
      %self: !struct.type<@Child>,
      %v: !felt.type<"bn128"> {llzk.pub}
    ) {
      function.return
    }
  }

  struct.def @Main {
    struct.member @child : !struct.type<@Child>

    function.def @compute(
      %v: !felt.type<"bn128"> {function.arg_name = "v"}
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %child = function.call @Child::@compute(%v) :
          (!felt.type<"bn128">) -> !struct.type<@Child>
      struct.writem %self[@child] = %child :
          !struct.type<@Main>, !struct.type<@Child>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
      %self: !struct.type<@Main>,
      %v: !felt.type<"bn128"> {llzk.pub}
    ) {
      %child = struct.readm %self[@child] :
          !struct.type<@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %v) :
          (!struct.type<@Child>, !felt.type<"bn128">) -> ()
      %previous = struct.readm %child[@x] :
          !struct.type<@Child>, !felt.type<"bn128">
          {tableOffset = -1 : index}
      constrain.eq %previous, %v : !felt.type<"bn128">
      function.return
    }
  }
}

//--- control.llzk

module attributes {llzk.lang, llzk.main = !struct.type<@Main>} {
  struct.def @Child {
    struct.member @x : !felt.type<"bn128"> {column, llzk.pub}

    function.def @compute(
      %v: !felt.type<"bn128"> {function.arg_name = "v"}
    ) -> !struct.type<@Child> {
      %self = struct.new : !struct.type<@Child>
      struct.writem %self[@x] = %v :
          !struct.type<@Child>, !felt.type<"bn128">
      function.return %self : !struct.type<@Child>
    }

    function.def @constrain(
      %self: !struct.type<@Child>,
      %v: !felt.type<"bn128"> {llzk.pub}
    ) {
      function.return
    }
  }

  struct.def @Main {
    struct.member @child : !struct.type<@Child>

    function.def @compute(
      %v: !felt.type<"bn128"> {function.arg_name = "v"}
    ) -> !struct.type<@Main> {
      %self = struct.new : !struct.type<@Main>
      %child = function.call @Child::@compute(%v) :
          (!felt.type<"bn128">) -> !struct.type<@Child>
      struct.writem %self[@child] = %child :
          !struct.type<@Main>, !struct.type<@Child>
      function.return %self : !struct.type<@Main>
    }

    function.def @constrain(
      %self: !struct.type<@Main>,
      %v: !felt.type<"bn128"> {llzk.pub}
    ) {
      %child = struct.readm %self[@child] :
          !struct.type<@Main>, !struct.type<@Child>
      function.call @Child::@constrain(%child, %v) :
          (!struct.type<@Child>, !felt.type<"bn128">) -> ()
      %current = struct.readm %child[@x] :
          !struct.type<@Child>, !felt.type<"bn128">
      constrain.eq %current, %v : !felt.type<"bn128">
      function.return
    }
  }
}

//--- input.json
[1]
